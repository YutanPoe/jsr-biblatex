\ProvidesFile{jsr.bbx}[2022/11/24\space v0.1\space 日本社会学会 2022年版文献スタイル]

\RequireBibliographyStyle{authoryear}%

% ------------------------------------------------------------------
% フォーマットコマンド
% ------------------------------------------------------------------

% フォーマットコマンドなどの作成
% ------------------------------------------------------------------

% Declare the language mapping suffix
\DeclareLanguageMappingSuffix{-jsr}

%%% ソート順番の定義
\DeclareSortingTemplate{nymdt}{%
  \sort{%
    \field{presort}%
  }%
  \sort[final]{%
    \field{sortkey}%
  }%
  \sort{%
    \field{sortname}%
    \field{author}%
    \field{editor}%
    \field{translator}%
    \field{sorttitle}%
    \field{title}%
  }%
  \sort{%
    \field{sortyear}%
    \field{year}%
  }%
  \sort{%
    \field{month}%
  }%
  \sort{%
    \field{day}%
  }%
  \sort{%
    \field{sorttitle}%
    \field{title}%
  }%
  \sort{%
    \field{volume}%
    \literal{0}%
  }%
}%

%%% オプションの設定
\ExecuteBibliographyOptions{%
autocite=inline,%
%date=comp,%
maxbibnames=99,%
minbibnames=19,%
mincrossrefs=999,%
maxitems=999,%
sorting=nymdt,%
%urldate=ymd,%
dateabbrev=false,%
%useorigauthor=true,%
labeldateparts=true,
giveninits=false,
citecounter=true,
citetracker=true,
}%

%%% 同著者ダッシュ %%%
\renewcommand*{\bibnamedash}{------------}%
%\renewcommand{\bibnamedash}{\rule[.55ex]{4em}{.3pt}}%
%%% ぶら下がりインデント幅 %%%
%%\setlength{\bibhang}{2\zw}%
\setlength{\bibhang}{2em}%

%%% （擬似）全角幅のスペース
\newrobustcmd*{\addjspace}{%
  \unspace\blx@postpunct
  \ \space\ \blx@imc@resetpunctfont}%

%%% 言語判断用変数 %%%
\newboolean{japanese}%
\setboolean{japanese}{false}%

%%% 言語判断用変数 %%%
\newboolean{CJK}%
\setboolean{CJK}{false}%

\newbibmacro*{checkCJK}{%
  \ifboolexpr{%
    test {\iffieldequalstr{langid}{japanese}}
    or
    test {\iffieldequalstr{langid}{chinese}}
    or
    test {\iffieldequalstr{langid}{korean}}
  }{\setboolean{CJK}{true}}{\setboolean{CJK}{false}}}%

%%% 氏名反転用変数 %%%
% Offにすると名前-名字の順になる。日本語は常に名字-名前になっているので関係なし。
\newboolean{reversenamebool}%
\setboolean{reversenamebool}{false}%

%%% related判定変数 %%%
\newboolean{relatedbool}%
\setboolean{relatedbool}{false}%

% 引用されるごとの処理
\AtEveryBibitem{%
  % 日本語文献かどうかをチェック（必ず初期化する）
  %\iffieldequalstr{langid}{japanese}
    %{\setboolean{japanese}{true}\selectlanguage{japanese}}%
    %{\setboolean{japanese}{false}%
  \usebibmacro{checkCJK}%
  \iffieldundef{langid}{\selectlanguage{american}}{}
  % 氏名反転をOnに
  \setboolean{reversenamebool}{true}%
}%

%%% multiciteコマンド使用時の言語の設定
\newtoggle{bbx:engmode}%
\settoggle{bbx:engmode}{false}%
\DeclareBibliographyOption[boolean]{engmode}{\settoggle{bbx:engmode}{#1}}%

\newtoggle{bbx:eprinttype}%
\DeclareBiblatexOption{global,type,entry}[boolean]{eprinttype}[true]{%
  \settoggle{bbx:eprinttype}{#1}}%

%%% デリム（区切り文字）
%% コマンド追加・修正
\renewcommand*{\newunitpunct}%基本の区切り文字
  {\ifthenelse{\boolean{CJK}}{\unspace{，}}{\addcomma\space}}%
\renewcommand*{\labelnamepunct}{\addperiod\space}%
%\newcommand*{\jecomma}%基本の区切り文字（setunit用）
%  {\ifthenelse{\boolean{CJK}}{\unspace{，}}{\addcomma\space}}%
\renewcommand*{\subtitlepunct}%
  {\ifthenelse{\boolean{CJK}}%
    {------}%\hskip.1em\rule[.7ex]{1.8em}{.3pt}\hskip.1em}%
    {\addcolon\space}}%
\renewcommand*{\finentrypunct}%
  {\ifthenelse{\boolean{CJK}}%
    {\unspace{．}}%
    {\addperiod}}%
\renewcommand*{\bibnamedelimd}%givennameの直前のスペース
  {\ifthenelse{\boolean{CJK}}%
    {\unspace}%
    {\addlowpenspace}}%

%% デリム定義変更
% 基本の区切り文字
\DeclareDelimFormat{jecomma}%
  {\ifthenelse{\boolean{CJK}}{\unspace{，}}{\addcomma\space}}%
\DeclareDelimFormat{jecolon}{\ifthenelse{\boolean{CJK}}{\unspace{：}}{\addcolon\space}}%
\DeclareDelimFormat{jesemicolon}{\ifthenelse{\boolean{CJK}}{\unspace{；}}{\addsemicolon\space}}%
% 名前とXXフィールド
\DeclareDelimAlias[bib,biblist]{nameyeardelim}{jecomma}%
\DeclareDelimAlias[bib,biblist]{datetitledelim}{jecomma}%
% 名前とタイプ
\DeclareDelimFormat{authortypedelim}%
  {\ifthenelse{\boolean{CJK}}{\unspace}{\addspace}}%
\DeclareDelimAlias{editortypedelim}{authortypedelim}%
\DeclareDelimAlias{translatortypedelim}{authortypedelim}%
% 氏名反転時のデリム
\DeclareDelimFormat{revsdnamepunct}%
  {\ifthenelse{\boolean{CJK}}{\unspace}{\addcomma}}%
% タイトル関連
\DeclareDelimFormat{titledelim}%
  {\ifthenelse{\boolean{CJK}}{\unspace}{\addcomma\space}}%
%\DeclareDelimAlias{titleafterdelim}{titledelim}%
% 名前連続時
\DeclareDelimFormat[bib,biblist]{multinamedelim}%
  {\ifthenelse{\boolean{CJK}}{\unspace{・}}{\addcomma\space}}%
\DeclareDelimFormat[bib,biblist]{finalnamedelim}%
{\ifthenelse{\boolean{CJK}}%
  {\unspace{・}}%
  {\ifthenelse{\value{listcount}>\maxprtnames}%
    {}%
    %{%\ifthenelse{\value{liststop}>2}%
      %{\finalandcomma\addspace\&\space}%
      {\addspace\&\space}%
    %}%
  }%
}%
% relatedフィールド間のデリム
\DeclareDelimFormat{relatedpunct}%
  {\ifthenelse{\boolean{CJK}}{\unspace}{\addspace}}%
% おわりのデリム（後で削除する可能性あり）
  \DeclareDelimFormat{findelim}%
  {\ifthenelse{\boolean{CJK}}{\unspace{．}}{\addperiod}}%
% ダブルクォーテーション内部にコンマを挿入するための
\DeclareQuotePunctuation{,}%
\DefineBibliographyExtras{english}{%langidがenglishでもブルクォーテーション内部にコンマを挿入する
  \uspunctuation
}
%%% フィールドの定義
%% 追加
% 全角かっこ包み込み
%\DeclareFieldFormat{jpparens}{\unspace{（}\unspace#1\unspace{）}\unspace}%
\DeclareFieldFormat{jpparens}{\mkbibjpparens{#1}}%
% 全角or半角かっこ包み込み
\DeclareFieldFormat{jeparens}%
  {\ifthenelse{\boolean{CJK}}{\mkbibjpparens{#1}}{\mkbibparens{#1}}}%
% 二重かっこ（booktitle）
\DeclareFieldFormat{jedkakko}%
  {\ifthenelse{\boolean{CJK}}{『#1』}{\emph{#1}}}%
% かっこ
\DeclareFieldFormat{jekakko}{\mkbibquote{#1}}%
% URL取得日
\DeclareFieldFormat{urldate}%
  {\ifthenelse{\boolean{CJK}}%
    %{\thefield{urlyear}年\thefield{urlmonth}月\thefield{urlday}日取得}%
    {\mkbibdatelong{urlyear}{urlmonth}{urlday}取得}%
    {Retrieved\space\mkbibdatelong{urlyear}{urlmonth}{urlday}}%
  }%

\DeclareFieldFormat[article]{date}{\mkbibdatelong{year}{month}{day}}%

%% 変更：すなおにそのまま
\DeclareFieldFormat{pages}{\mkcomprange{#1}}%
\DeclareFieldFormat{url}{\texttt{\url{#1}}}%
\DeclareFieldFormat{doi}{\texttt{\url{https://doi.org/#1}}}%
\DeclareFieldFormat{version}{#1}%
\DeclareFieldFormat{title}{#1}%
\DeclareFieldFormat{subtitle}{#1}%
\DeclareFieldAlias{booktitle}{title}%
\DeclareFieldAlias{booksubtitle}{subtitle}%
\DeclareFieldAlias{journaltitle}{title}%
\DeclareFieldAlias{journalsubtitle}{subtitle}%
\DeclareFieldAlias{series}{title}%
\urlstyle{same}% URLのフォントを本文に揃える

%%%%%%% 基本設定 %%%%%%%

%%% 著者名の最大数 %%%
\newcount\maxprtnames\maxprtnames=20%
\DeclareBibliographyOption{maxprtnames}{%
  \ifstrempty{#1}{}{\maxprtnames=#1}}%

%%% 著者名の表示順（日英ともに姓・名の順）
\DeclareNameAlias{sortname}{family-given}%

% %%% 著者名の区別を抑制
%\DeclareUniquenameTemplate{%
%  \namepart[use=true, base=true]{prefix}%
%  \namepart[base=true]{family}%
%  \namepart[base=true]{giveni}%
%  \namepart{suffix}%
%}%

%%% 著者名のフォーマット
%%% 先頭のsortするためだけのもの。日本語は常にそのまま、それ以外のみ変更。将来はCJKに対象を拡大したいな。
\DeclareNameFormat{sortname}{%
  \ifthenelse{\boolean{CJK}}{%
    \usebibmacro{name:family-given}%
      {\namepartfamily}%
      {\namepartgiven}%
      {\namepartprefix}%
      {\namepartsuffix}%
  }{% 英語文献の場合、最初の名前のみ姓・名でそのほかは名・姓とする。biblatex.defから引用。
    \ifnumequal{\value{listcount}}{1}
      {\ifgiveninits
        {\usebibmacro{name:family-given}
          {\namepartfamily}
          {\namepartgiveni}
          {\namepartprefix}
          {\namepartsuffix}}
        {\usebibmacro{name:family-given}
          {\namepartfamily}
          {\namepartgiven}
          {\namepartprefix}
          {\namepartsuffix}}%
      \ifboolexpe{%
        test {\ifdefvoid\namepartgiven}
        and
        test {\ifdefvoid\namepartprefix}}
        {}
        {\usebibmacro{name:revsdelim}}}
      {\ifgiveninits
        {\usebibmacro{name:given-family}
          {\namepartfamily}
          {\namepartgiveni}
          {\namepartprefix}
          {\namepartsuffix}}
        {\usebibmacro{name:given-family}
          {\namepartfamily}
          {\namepartgiven}
          {\namepartprefix}
          {\namepartsuffix}}}%
  }%
}%
%%% 先頭以外の名前。普通。
\DeclareNameFormat{default}{%
  \ifthenelse{\boolean{CJK}}{%
    \usebibmacro{name:family-given}%
      {\namepartfamily}%
      {\namepartgiven}%
      {\namepartprefix}%
      {\namepartsuffix}%
  }{%
  \ifgiveninits
    {\usebibmacro{name:given-family}
      {\namepartfamily}
      {\namepartgiveni}
      {\namepartprefix}
      {\namepartsuffix}}
    {\usebibmacro{name:given-family}
      {\namepartfamily}
      {\namepartgiven}
      {\namepartprefix}
      {\namepartsuffix}}}}%

