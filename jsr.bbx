%%% ==================================================================
%%% もろもろの設定
%%% ==================================================================

%%% 継承設定 %%%
\RequireBibliographyStyle{authoryear}%authoryearを継承。継承先はauthoryear→standard→def

%%% 独自のlbxの読み込み %%%
\DeclareLanguageMappingSuffix{-jsr}%lbxのjsr個別のものを読み込む

%%% ソート順番の定義
%% 同一著者の並び順（ガイド 4.4）：単著→単独編書→共著→共編書，各カテゴリ内は刊行年順。
%%  ・名前の並べ替えには第1著者だけを使う（maxsortnames=1）。名前が2人以上のリストには
%%    biber が「ほか」を示す最大の文字を付けるので，同じ第1著者なら単数（単著・単独編書）が
%%    複数（共著・共編書）より前に来る。
%%  ・jsrsortrole（著者あり＝1，編者のみ＝2。sourcemap で設定）で，著書を編書より前にする。
%%  ・年は原典の刊行年（origdate）を優先し，同じなら手元の版の年で並べる。
\DeclareSortingTemplate{nymdt}{%
  \sort{%
    \field{presort}%
  }%
  \sort[final]{%
    \field{sortkey}%
  }%
  \sort{%
    \field{sortname}%
    \field{author}%
    \field{editor}%
    \field{translator}%
    \field{sorttitle}%
    \field{title}%
  }%
  \sort{%
    \field{jsrsortrole}%
  }%
  \sort{%
    \field{sortyear}%
    \field{origyear}%
    \field{year}%
  }%
  \sort{%
    \field{year}%
  }%
  \sort{%
    \field{month}%
  }%
  \sort{%
    \field{day}%
  }%
  \sort{%
    \field{sorttitle}%
    \field{title}%
  }%
  \sort{%
    \field{volume}%
    \literal{0}%
  }%
}%

%%% オプションの設定
\ExecuteBibliographyOptions{%
autocite=inline,%
%date=comp,%
maxbibnames=99,%
minbibnames=19,%
maxsortnames=1,% ソートは第1著者で（同一著者の並び順。ソート順番の定義を参照）
minsortnames=1,%
mincrossrefs=999,%
maxitems=999,%
sorting=nymdt,%
%urldate=ymd,%
dateabbrev=false,%
%useorigauthor=true,%
labeldateparts=true,
giveninits=false,
citecounter=true,
citetracker=true,
autolang=other,%
language=auto,%
doi=false,% 既定は，取得日（urldate）があるときだけ DOI を出す。doi=true で，取得日がなくても出す
}%

%%% 訳書・再録の原典（related 先）の複製を，文献リストの代表として扱えるようにする %%%
% biber は related 先の複製（clone）を作るが，既定では dataonly（印刷せず，ラベルも付けない）。
% relatedoptions を与えると，複製は通常のエントリとして並べられ，extradate も付く。
% 原典そのものが引用されている場合，biber は複製に skipbib を加える（原典が代表になる）。
% bib 側に relatedoptions が書かれていれば，それを優先する。
\DeclareStyleSourcemap{%
  \maps[datatype=bibtex]{%
    \map{%
      \step[fieldsource=related, final]%
      \step[fieldsource=relatedtype, match=\regexp{\A(translationof|reprintof)\Z}, final]%
      \step[fieldset=relatedoptions, fieldvalue={skipbiblist}]%
    }%
    % 旧形式の読み替え（2026-10-24）。警告用の印（jsrlegacy）を付けてから読み替える。
    %  ・webpagetitle（ウェブサイト名）→ titleaddon
    %  ・@report＋type=onlinereport（オンラインで取得した報告書）→ @online（institution→organization，type は消す）
    \map{%
      \step[fieldsource=webpagetitle, final]%
      \step[fieldset=jsrlegacy, fieldvalue={webpagetitle}]%
    }%
    \map{%
      \step[fieldsource=webpagetitle, fieldtarget=titleaddon]%
    }%
    \map[overwrite=true]{%
      \pertype{report}%
      \step[fieldsource=type, match=\regexp{\Aonlinereport\Z}, final]%
      \step[fieldset=jsrlegacy, fieldvalue={onlinereport}]%
      \step[fieldsource=institution, fieldtarget=organization]%
      \step[fieldset=type, null=true]%
      \step[typesource=report, typetarget=online]%
    }%
    % 値が空白だけのフィールド（author = {} など）は，書かれていないものとして消す（2026-10-25）。
    % biber の notfield は「フィールドが存在するか」を調べるので，空の値を残すと，後ろの規則
    % （sortname の警告，署名のない記事の除外）が効かない。
    \map{%
      \step[fieldsource=author, match=\regexp{\A\s*\Z}, final]%
      \step[fieldset=author, null=true]%
    }%
    \map{%
      \step[fieldsource=editor, match=\regexp{\A\s*\Z}, final]%
      \step[fieldset=editor, null=true]%
    }%
    \map{%
      \step[fieldsource=translator, match=\regexp{\A\s*\Z}, final]%
      \step[fieldset=translator, null=true]%
    }%
    \map{%
      \step[fieldsource=sortname, match=\regexp{\A\s*\Z}, final]%
      \step[fieldset=sortname, null=true]%
    }%
    % sortname がない：書き忘れの警告用の印（bbl には sortname が出力されないので，biber の段階で印を付ける）
    % crossref／xref で親から継承する項目は，この段階では継承前なので対象外にする
    \map{%
      \step[notfield=sortname, final]%
      \step[notfield=crossref, final]%
      \step[notfield=xref, final]%
      \step[fieldset=jsrnosortname, fieldvalue={1}]%
    }%
    % article ドライバを使う型（article、misc、software、patent）で author がないものは，文献リストに載せない
    % （文献注にだけ出る）。ドライバは author がなければ何も出さないので，載せると空の項目（空行）ができる（2026-10-25）。
    % 印（jsrnoauthor）を付け，印のあるものに skipbib を加える。skipbib があるとリストに空の項目ができない。
    % ラベルは通常どおり付くので，文献注の extradate には影響しない。
    % 印の値は，新聞・雑誌（entrysubtype と互換の type=）が news，それ以外が 1。1 のものは，bbx の
    % \jsr@datainput が警告を出す（署名のない新聞・雑誌は仕様どおりなので警告しない）。
    % crossref／xref で親から author を継承する項目は，この段階では継承前なので対象外にする。
    % options が既にあるときとないときで分ける（あるときは，overwrite を立てて追記する。
    % biber は値をそのまま連結するので先頭にコンマを付ける）。
    \map{%
    \pertype{article}\pertype{misc}\pertype{software}\pertype{patent}%
      \step[notfield=author, final]%
      \step[notfield=crossref, final]%
      \step[notfield=xref, final]%
      \step[fieldset=jsrnoauthor, fieldvalue={1}]%
    }%
    \map[overwrite=true]{%
      \step[fieldsource=jsrnoauthor, final]%
      \step[fieldsource=entrysubtype, match=\regexp{\A(newspaper|magazine)\Z}, final]%
      \step[fieldset=jsrnoauthor, fieldvalue={news}]%
    }%
    \map[overwrite=true]{%
      \step[fieldsource=jsrnoauthor, final]%
      \step[fieldsource=type, match=\regexp{\A(newspaper|magazine)\Z}, final]%
      \step[fieldset=jsrnoauthor, fieldvalue={news}]%
    }%
    \map{%
    \pertype{article}\pertype{misc}\pertype{software}\pertype{patent}%
      \step[fieldsource=jsrnoauthor, final]%
      \step[notfield=options, final]%
      \step[fieldset=options, fieldvalue={skipbib}]%
    }%
    \map[overwrite=true]{%
    \pertype{article}\pertype{misc}\pertype{software}\pertype{patent}%
      \step[fieldsource=jsrnoauthor, final]%
      \step[fieldsource=options, final]%
      \step[fieldset=options, fieldvalue={,skipbib}, append]%
    }%
    % ソート用：著者がいれば 1，編者のみなら 2
    \map{%
      \step[fieldsource=author, final]%
      \step[fieldset=jsrsortrole, fieldvalue={1}]%
    }%
    \map{%
      \step[notfield=author, final]%
      \step[fieldsource=editor, final]%
      \step[fieldset=jsrsortrole, fieldvalue={2}]%
    }%
  }%
}%

%%% 報告書所収の論文 %%%
% @incollection に crossref で親の @report を指す（ガイド 4.4(8) の岩本 1997 のような文献）。
% 親の title／subtitle を booktitle／booksubtitle として引き継ぐ。editor、type、number、institution は
% 同名のフィールドとして既定の規則で引き継がれる（incollection が書名の後に出す。report:parent）。
% （\DeclareDataInheritance は dbx の読み込み時にはまだ使えないので，bbx に書く）
\DeclareDataInheritance{report}{incollection,inbook}{%
  \inherit{title}{booktitle}
  \inherit{subtitle}{booksubtitle}
  \inherit{titleaddon}{booktitleaddon}
  \noinherit{shorttitle}
  \noinherit{sorttitle}
  \noinherit{indextitle}
  \noinherit{indexsorttitle}
}

%%% ぶら下がりインデント幅 %%%
\setlength{\bibhang}{2em}%本来はzwが使用できれば{2\zw}のほうがよいが、そうではない可能性もあるので。

%%% 著者名の最大数 %%%
\newcount\maxprtnames\maxprtnames=20%
\DeclareBibliographyOption{maxprtnames}{%
  \ifstrempty{#1}{}{\maxprtnames=#1}}%



%%% ==================================================================
%%% 変数の定義・最初の処理
%%% ==================================================================

%%% 言語判断用変数 %%%
\newboolean{CJK}%
\setboolean{CJK}{false}%

%%% 氏名反転用変数 %%%
% Offにすると名前-名字の順になる。日本語は常に名字-名前になっているので関係なし。
\newboolean{reversenamebool}%
\setboolean{reversenamebool}{false}%

%%% related判定変数 %%%
\newboolean{relatedbool}%
\setboolean{relatedbool}{false}%

% 引用されるごとの処理
\AtEveryBibitem{%
  \usebibmacro{checkLang}%言語の判定
  \jsr@chksortname% 和文の文献の sortname の書き忘れの検出
  \jsr@chklegacy% 旧形式の bib の検出
  \jsr@chkperiodical% 編者のない @periodical の検出
  \jsr@scankata% カタカナ名の判定
  \setboolean{reversenamebool}{true}%氏名反転をOnに
}%

% 新聞・雑誌の記事か。標準の entrysubtype（newspaper／magazine）で判定する。
% 互換のため type=newspaper／magazine も受け付ける（2026-10-24 決定）。
\newcommand*{\jsr@ifnewspaper}{%
  \ifboolexpr{ test {\iffieldequalstr{entrysubtype}{newspaper}}
                or test {\iffieldequalstr{type}{newspaper}} }}
\newcommand*{\jsr@ifnewsmag}{%
  \ifboolexpr{ test {\iffieldequalstr{entrysubtype}{newspaper}}
                or test {\iffieldequalstr{entrysubtype}{magazine}}
                or test {\iffieldequalstr{type}{newspaper}}
                or test {\iffieldequalstr{type}{magazine}} }}

% 和文（CJK）の文献で，著者・編者がいるのに sortname がないときは警告を出す。
% ローマ字は自動では作れないので，漢字のコード順で並び，ローマ字順の並びから外れる（書き忘れの検出だけ行う）。
\newcommand*{\jsr@chksortname}{%
  \ifboolexpr{ bool {CJK}
    and ( not test {\ifnameundef{author}} or not test {\ifnameundef{editor}} )
    and not test {\iffieldundef{jsrnosortname}} }
    {\blx@warning@noline{jsr: entry '\thefield{entrykey}' has no sortname\MessageBreak
       (CJK entries are sorted by character code without it)}}
    {}}

% @periodical（雑誌の号全体）に編者がないときは警告を出す（出力は，名前なしで誌名・年の順）。
\newcommand*{\jsr@chkperiodical}{%
  \ifentrytype{periodical}
    {\ifboolexpr{ test {\ifnameundef{editor}} and test {\ifnameundef{author}} }
       {\blx@warning@noline{jsr: periodical '\thefield{entrykey}' has no editor}}
       {}}
    {}}

% 旧形式の bib（webpagetitle、@report＋type=onlinereport）は sourcemap で読み替えるが、書き換えを促す警告を出す。
\newcommand*{\jsr@chklegacy}{%
  \iffieldundef{jsrlegacy}{}{%
    \iffieldequalstr{jsrlegacy}{webpagetitle}
      {\blx@warning@noline{jsr: entry '\thefield{entrykey}' uses deprecated 'webpagetitle'\MessageBreak
         (use titleaddon for the website name)}}
      {\blx@warning@noline{jsr: entry '\thefield{entrykey}' uses deprecated 'type=onlinereport'\MessageBreak
         (use @online with organization instead of @report)}}}}

\newbibmacro*{checkLang}{%CJKの判断と、langidがない場合はとりあえずamericanにする処理
  \ifboolexpr{%
    test {\iffieldequalstr{langid}{japanese}}
    or
    test {\iffieldequalstr{langid}{chinese}}
    or
    test {\iffieldequalstr{langid}{korean}}
  }{\setboolean{CJK}{true}}{\setboolean{CJK}{false}}%
  % langid がない，または文書に読み込まれていない言語（french など）の欧文は american で組む
  \iffieldundef{langid}
    {\selectlanguage{american}}
    {\xifinlist{\thefield{langid}}\jsr@doclangs
       {}
       {% biblatex の autolang はこのあと langid の言語に切り替えるので，langid を消してそれを止める
        \clearfield{langid}%
        \ifbool{CJK}
          {\ifcsundef{datejapanese}{}{\selectlanguage{japanese}}}% chinese／korean が未読み込みなら japanese で組む
          {\selectlanguage{american}}}}}%

% プリアンブル終了時に読み込まれている言語の一覧。
% 新しい babel は未読み込みの言語も \select@language の中で読み込むため，date<言語> の有無では判定できない。
\def\jsr@doclangs{}
\def\jsr@addlang#1{\listxadd\jsr@doclangs{#1}}
\AtEndPreamble{%
  \ifdef\bbl@loaded
    {\expandafter\forcsvlist\expandafter\jsr@addlang\expandafter{\bbl@loaded}}{}%
  \ifdef\bbl@ini@loaded
    {\expandafter\forcsvlist\expandafter\jsr@addlang\expandafter{\bbl@ini@loaded}}{}%
  \ifdef\xpg@bloaded
    {\expandafter\forcsvlist\expandafter\jsr@addlang\expandafter{\xpg@bloaded}}
    {\ifdef\xpg@loaded
       {\expandafter\forcsvlist\expandafter\jsr@addlang\expandafter{\xpg@loaded}}{}}}%

%%% カタカナ書きの外国人名（ガイド 4.4(2)）%%%
% 和文の文献で，カタカナ書きの外国人名は「名・姓」の順に中黒でつなぐ（ロス・マオア）。
% そうした名前を含む名前リストでは，名前の区切りを中黒に代えて全角スラッシュにする（杉本良夫／ロス・マオア）。
% 判定は姓の先頭の文字がカタカナ（U+30A1–U+30FA）かどうか（LuaTeX／XeTeX／upTeX を前提とする）。
\newbool{jsr@kata}
\def\jsr@ifkatakana#1{\expandafter\jsr@ifkatakana@i#1\relax\@nil}
\def\jsr@ifkatakana@i#1#2\@nil{%
  \let\jsr@tmpres\@secondoftwo
  \ifcat\noexpand#1\relax\else
    \ifnum`#1>"30A0\relax
      \ifnum`#1<"30FB\relax\let\jsr@tmpres\@firstoftwo\fi
    \fi
  \fi
  \jsr@tmpres}
% カタカナ名：名・姓
\newbibmacro*{jsr:kataname}{%
  \begingroup
  \def\bibnamedelimd{・}%
  \usebibmacro{name:given-family}{\namepartfamily}{\namepartgiven}{\relax}{\relax}%
  \endgroup}
% 和文の名前の出力。#1 は通常の書式（family-given など）
\newcommand*{\jsr@cjkname}[1]{%
  \jsr@ifkatakana\namepartfamily
    {\usebibmacro{jsr:kataname}}
    {\usebibmacro{name:#1}{\namepartfamily}{\namepartgiven}{\namepartprefix}{\namepartsuffix}}}
% 名前リストにカタカナ名が含まれるかを，エントリごとに先に調べておく（\jsr@kata@<リスト名>）
\DeclareNameFormat{jsr:katascan}{%
  \jsr@ifkatakana\namepartfamily{\global\booltrue{jsr@kata}}{}}
\def\jsr@katalists{author,editor,translator,bookauthor,labelname}
\def\jsr@scankata@i#1{%
  \global\boolfalse{jsr@kata}%
  \ifboolexpr{ bool {CJK} and not test {\ifnameundef{#1}} }
    {\jsr@savepunct
     \setbox\z@\hbox{\printnames[jsr:katascan]{#1}}%
     \jsr@restorepunct}
    {}%
  \ifbool{jsr@kata}{\csgdef{jsr@kata@#1}{}}{\csgundef{jsr@kata@#1}}}
\newcommand*{\jsr@scankata}{%
  \expandafter\forcsvlist\expandafter\jsr@scankata@i\expandafter{\jsr@katalists}}
% 和文の名前の区切り（中黒または全角スラッシュ）
\newcommand*{\jsr@cjknamedelim}{%
  \unspace\ifcsdef{jsr@kata@\currentname}{／}{・}}

%%% multiciteコマンド使用時の言語の設定
%\newtoggle{bbx:engmode}%
%\settoggle{bbx:engmode}{false}%
%\DeclareBibliographyOption[boolean]{engmode}{\settoggle{bbx:engmode}{#1}}%

\newtoggle{bbx:eprinttype}%
\DeclareBiblatexOption{global,type,entry}[boolean]{eprinttype}[true]{%
  \settoggle{bbx:eprinttype}{#1}}%



%%% ==================================================================
%%% コマンドの修正・宣言
%%% ==================================================================

%%% デリム（区切り文字） %%%
%newunitは半角全角コンマ
\renewcommand*{\newunitpunct}{\ifthenelse{\boolean{CJK}}{\unspace{，}}{\addcomma\space}}%
%副題は2倍ダッシュとコロン
\renewcommand*{\subtitlepunct}%
  {\ifthenelse{\boolean{CJK}}%
    {------}%\hskip.1em\rule[.7ex]{1.8em}{.3pt}\hskip.1em}%本来は2倍ダッシュ
    {\addcolon\space}}%
%エントリの最後のpunctation。全角もしくは半角のピリオド
\renewcommand*{\finentrypunct}%
  {\ifthenelse{\boolean{CJK}}%
    {\unspace{．}}%
    {\addperiod}}%
\renewcommand*{\bibnamedelimd}%givennameの直前のスペース
  {\ifthenelse{\boolean{CJK}}%
    {\unspace}%
    {\addlowpenspace}}%
\newcommand*{\addhnspace}{\ifthenelse{\boolean{CJK}}{\unspace}{\addspace}}%CJKならunspace, それ以外ならspace

%%% 同著者ダッシュ %%%
\renewcommand*{\bibnamedash}{------------}%本来は4倍ダッシュ

%%% かっこ %%%
% 全角丸かっこ（cbx の \parencite も使う）
\newcommand{\mkbibfparens}[1]{\unspace{（}#1\unspace{）}}%
% 全角・半角の丸カッコを言語（CJK）に応じて自動で切り替える
\newrobustcmd*{\mkbibfhparens}[1]{%
  \ifthenelse{\boolean{CJK}}
    {\mkbibfparens{#1}}
    {\mkbibparens{#1}}%
}



%%% ==================================================================
%%% フォーマットの修正・宣言
%%% ==================================================================

%%% デリム %%%
% 基本の区切り文字
\DeclareDelimFormat{fhcomma}%
  {\ifthenelse{\boolean{CJK}}{\unspace{，}}{\addcomma\space}}%
\DeclareDelimFormat{fhcolon}{\ifthenelse{\boolean{CJK}}{\unspace{：}}{\addcolon\space}}%
\DeclareDelimFormat{fhsemicolon}{\ifthenelse{\boolean{CJK}}{\unspace{；}}{\addsemicolon\space}}%
% フィールド間
\DeclareDelimAlias[bib,biblist]{nameyeardelim}{fhcomma}%
\DeclareDelimAlias[bib,biblist]{datetitledelim}{fhcomma}%
% 名前とタイプ
\DeclareDelimFormat{authortypedelim}{\addhnspace}%
\DeclareDelimAlias{editortypedelim}{authortypedelim}%
% 訳者：和文は「日高六郎訳」，欧文は「Lauretta Clough, trans.,」（ガイド 4.2(6)）
\DeclareDelimFormat{translatortypedelim}%
  {\ifthenelse{\boolean{CJK}}{\unspace}{\addcomma\space}}%
% 氏名反転時のデリム
\DeclareDelimFormat{revsdnamepunct}%
  {\ifthenelse{\boolean{CJK}}{\unspace}{\addcomma}}%
% タイトル関連
\DeclareDelimFormat{titledelim}%
  {\ifthenelse{\boolean{CJK}}{\unspace}{\addcomma\space}}%
%\DeclareDelimAlias{titleafterdelim}{titledelim}%
% 名前連続時最後以外の区切り
\DeclareDelimFormat[bib,biblist]{multinamedelim}%
  {\ifthenelse{\boolean{CJK}}{\jsr@cjknamedelim}{\addcomma\space}}%
% 名前連続時最後の区切り
\DeclareDelimFormat[bib,biblist]{finalnamedelim}%
  {\ifthenelse{\boolean{CJK}}{\jsr@cjknamedelim}{\addhnspace\bibstring{and}\addhnspace}}%
% relatedフィールド間のデリム
\DeclareDelimFormat{relatedpunct}{\addhnspace}%
% おわりのデリム, jsrではrelatedの後にもfindelimが必要なのでその場合の設定
\DeclareDelimFormat{findelim}{\finentrypunct}%

%%% かっこ %%%
% 全角かっこ
\DeclareFieldFormat{fparens}{\mkbibfparens{#1}}%
% 全角 or半角かっこ
\DeclareFieldFormat{fhparens}{\mkbibfhparens{#1}}
% 全角かっこ包み込み/なし 再録処理専用
\DeclareFieldFormat{fnparens}%
  {\ifthenelse{\boolean{CJK}}{\mkbibfparens{#1}}{#1}}%
% 二重かぎかっこ（booktitle）
\DeclareFieldFormat{fhdkakko}%
  {\ifthenelse{\boolean{CJK}}{『#1』}{\emph{#1}}}%
% かぎかっこ
\DeclareFieldFormat{fhkakko}{\mkbibquote{#1}}%

%%% フィールドそのもの %%%
%ページ範囲は半角ハイフンで，重複する位は省略（102-104 → 102-4）。言語ごとの \bibrangedash（en dash）を局所的に置き換える
\newrobustcmd*{\mkjsrrange}[1]{{\renewcommand*{\bibrangedash}{-}\mkcomprange{#1}}}%
\DeclareFieldFormat{pages}{\mkjsrrange{#1}}%
\DeclareFieldFormat{url}{\texttt{\url{#1}}}%ちょっとおしゃれにタイプライタ体に
%\urlstyle{same}% URLのフォントを本文に揃える
\DeclareFieldFormat{doi}{\texttt{\url{https://doi.org/#1}}}%ちょっとおしゃれにタイプライタ体に
\DeclareFieldFormat{version}{#1}%
\DeclareFieldFormat{title}{#1}%文脈によって「」になったり『』になったりするので
\DeclareFieldFormat{subtitle}{#1}%
\DeclareFieldAlias{booktitle}{title}%
\DeclareFieldAlias{booksubtitle}{subtitle}%
\DeclareFieldAlias{journaltitle}{fhdkakko}%journaltitleのみnumberの扱いが異るためこちらで指定
\DeclareFieldAlias{journalsubtitle}{subtitle}%
\DeclareFieldAlias{issuetitle}{title}%@periodical の特集名（論文のタイトルと同じ書式）
\DeclareFieldAlias{issuesubtitle}{subtitle}%
\DeclareFieldAlias{series}{title}%
\DeclareFieldFormat[article]{date}{\mkbibdatelong{year}{month}{day}}%雑誌記事や新聞記事における日付はlong表示
\DeclareFieldFormat{volume}
  {\ifthenelse{\boolean{CJK}}{\bibstring{prenumber}#1\bibstring{volume}}{\bibstring{volume}\addspace#1}}%雑誌記事や新聞記事における日付はlong表示
\DeclareFieldFormat[article]{volume}{#1}%雑誌記事や新聞記事における日付はlong表示
\DeclareFieldFormat[periodical]{volume}{#1}%雑誌の号全体（@periodical）も同じ
\DeclareFieldFormat{part}
  {\ifthenelse{\boolean{CJK}}{\addspace#1}{.#1}}% physical part of a logical volume

% 版：欧文は 2nd ed. / Revised ed.，和文は 第2版 / 新版（奥付どおり。ガイド 4.4(1)）
\DeclareFieldFormat{edition}{%
  \ifinteger{#1}
    {\ifbool{CJK}
       {\bibstring{prenumber}#1\bibstring{edition}}
       {\mkbibordedition{#1}~\bibstring{edition}}}
    {\ifbool{CJK}{#1}{#1\isdot}}}

\DeclareFieldFormat{urldate}%
  {\ifthenelse{\boolean{CJK}}%
    {\mkbibdatelong{urlyear}{urlmonth}{urlday}\bibstring{urlseen}}%
    {\bibstring{urlseen}\space\mkbibdatelong{urlyear}{urlmonth}{urlday}}%
  }%

%%% 名前 %%%
%% 先頭のsortするためだけのもの %%%
\DeclareNameFormat{sortname}{%CJKは常にそのまま、
  \ifthenelse{\boolean{CJK}}{%
    \jsr@cjkname{family-given}%
  }{% その他の文献の場合、最初の名前のみ姓・名でそのほかは名・姓とする。biblatex.defから引用。
    \ifnumequal{\value{listcount}}{1}
      {\ifgiveninits
        {\usebibmacro{name:family-given}
          {\namepartfamily}
          {\namepartgiveni}
          {\namepartprefix}
          {\relax}}
        {\usebibmacro{name:family-given}
          {\namepartfamily}
          {\namepartgiven}
          {\namepartprefix}
          {\relax}}%
      \ifdefvoid\namepartsuffix{}{\addcomma\space\mkbibnamesuffix{\namepartsuffix}\midsentence}%
      \ifboolexpe{%
        test {\ifdefvoid\namepartgiven}
        and
        test {\ifdefvoid\namepartprefix}}
        {}
        {\usebibmacro{name:revsdelim}}}
      {\ifgiveninits
        {\usebibmacro{name:given-family}
          {\namepartfamily}
          {\namepartgiveni}
          {\namepartprefix}
          {\namepartsuffix}}
        {\usebibmacro{name:given-family}
          {\namepartfamily}
          {\namepartgiven}
          {\namepartprefix}
          {\namepartsuffix}}}%
  }%
}%

%% 先頭以外の名前, 普通の順番 %%
\DeclareNameFormat{default}{%
  \ifthenelse{\boolean{CJK}}{%
    \jsr@cjkname{family-given}%
  }{%
  \ifgiveninits
    {\usebibmacro{name:given-family}
      {\namepartfamily}
      {\namepartgiveni}
      {\namepartprefix}
      {\namepartsuffix}}
    {\usebibmacro{name:given-family}
      {\namepartfamily}
      {\namepartgiven}
      {\namepartprefix}
      {\namepartsuffix}}}}%

%%% その他 %%%
% ダブルクォーテーション内部にコンマを挿入するための
\DeclareQuotePunctuation{,}%
%langidがenglishでもブルクォーテーション内部にコンマを挿入する
%米国式句読点（\uspunctuation）は「?」「!」の直後のコンマを禁じるが，ガイドは “Title?,” の形なので許可する
\DefineBibliographyExtras{english}{\uspunctuation\DeclarePunctuationPairs{comma}{*!?}}%
\DefineBibliographyExtras{american}{\uspunctuation\DeclarePunctuationPairs{comma}{*!?}}%


%%% 雑誌名の前の「in:」を削除
\renewbibmacro{in:}{}%



%%% ==================================================================
%%% 文献情報フォーマット・マクロ
%%% ==================================================================

%%% 出版年 %%%
% 終了年のない範囲（刊行中の叢書・多巻本。date={1956/}）は，開始年（と a，b）だけを出す。
% 標準の \printlabeldateextra は範囲全体（1956/）を出してしまう。
% 終了年のフィールドが定義されていて空なら，終了年のない範囲。
\newrobustcmd*{\jsr@printdateextra}{%
  \ifcsdef{abx@field@endyear}%
    {\ifcsempty{abx@field@endyear}%
      {\printtext{\thefield{year}}\printfield{extradate}}%
      {\printlabeldateextra}}%
    {\printlabeldateextra}}
\renewbibmacro*{date+extradate}%
{\ifboolexpr{ test {\iffieldundef{year}} and not test {\iffieldundef{pubstate}} }%
  {\printfield{pubstate}%
    \setunit*{\printdelim{datetitledelim}}}%
  {\iffieldundef{labelyear}{}%
    {\printtext{\iflabeldateisdate{\jsr@printdateextra}{\jsr@printdateextra}}%
      \setunit*{\printdelim{datetitledelim}}%
    }%
  }%
}%

%%% 名前フィールドの出力マクロ 　%%%
%% 氏名逆転を判断したうえでnameを出力する本体 引数にはauthorやtranslatorなどが入る %%
\newbibmacro*{reversename}[1]{%
  \ifthenelse{\boolean{reversenamebool}}%
    {\printnames[sortname]{#1}}%
    {\printnames[default]{#1}}}%

%% 翻訳者→著者→編集者の順番にあるかどうかを判断し、ある場合はそのマクロを指定する
% 訳者を先頭に出すのは，原典に添える訳書（添え物）か，著者がいないとき。
% 原典のエントリがない単独の訳書は，著者を先頭にし，訳者は書名の後に出す（translator:after。2026-10-24 決定）。
\newbibmacro*{translator/author/editor}{%
  \ifboolexpr{%
    test {\ifnameundef{translator}}
    or
    ( not bool {bbx:inattach} and test \ifuseauthor and not test {\ifnameundef{author}} )
  }%
    {\ifboolexpr{%
       test \ifuseauthor
       and
       not test {\ifnameundef{author}}%
     }%
       {\usebibmacro{author}}%
       {\usebibmacro{editor}}}%
    {\usebibmacro{translator}}}

% 書名の後の訳者（単独の訳書）。先頭に出した訳者は消えているので，残っているときだけ出す
\newbibmacro*{translator:after}{%
  \ifnameundef{translator}{}{\usebibmacro{translator}}}%

%%% 同一著者のダッシュの判定 %%%
% authoryear.bbx の定義から，ページの先頭の項目では名前を出し直す条件（not test \iffirstonpage）だけを除いた。
% 同一著者は，ページに関係なく常にダッシュにする（2026-10-25 決定）。ほかの条件（直前と同じ fullhash，
% セット内の扱い）は標準のまま。TeX Live 2026（biblatex 3.22）の authoryear.bbx で確認した。
\renewbibmacro*{bbx:dashcheck}[2]{%
  \ifboolexpr{
    test {\iffieldequals{fullhash}{\bbx@lasthash}}
    and
    (
       not bool {bbx@inset}
       or
       test {\iffieldequalstr{entrysetcount}{1}}
    )
  }
    {#1}
    {#2}}

%%% 著者名 + authortype(あれば) %%%
\renewbibmacro*{author}%
{\ifboolexpr{%
  test \ifuseauthor
  and
  not test {\ifnameundef{author}}%
}%
  {\usebibmacro{bbx:dashcheck}%
    {\ifthenelse{\boolean{relatedbool}}%relatedの場合は直前のnamehashと一致していても、ダッシュは出力しない。
      {}{\bibnamedash\printdelim{nameyeardelim}}}%
    {\usebibmacro{bbx:savehash}%
    \usebibmacro{reversename}{author}%
    \iffieldundef{authortype}{}%
      {\setunit{\printdelim{authortypedelim}}%
      \usebibmacro{namestrg}{author}}%
    \setunit*{\printdelim{nameyeardelim}}}}%
  {\global\undef\bbx@lasthash}%%
}%

%%% 編集者名 %%%
%% 通常出力 %%
\renewbibmacro*{editor}%
{\ifboolexpr{%
  test \ifuseeditor
  and
  not test {\ifnameundef{editor}}%
}%
  {\usebibmacro{bbx:dashcheck}%
    {\ifthenelse{\boolean{relatedbool}}{}%relatedの場合は直前のnamehashと一致していても、ダッシュは出力しない。
      {\bibnamedash%ダッシュを出力
      \printdelim{editortypedelim}%和文は詰め（————編），欧文は空白（———— eds.）
      \usebibmacro{namestrg}{editor}%編などの文字
      \setunit*{\printdelim{nameyeardelim}}}}%区切り文字
    {\usebibmacro{reversename}{editor}%reverseかどうかを判断してprintname。唯一ここのみ先頭にくる可能性がある
    \setunit{\printdelim{editortypedelim}}%editorとtypeとの間のデリム
    \usebibmacro{bbx:savehash}%nameを保存
    \usebibmacro{namestrg}{editor}%編などの文字
    \clearname{editor}%clearする
    \usebibmacro{byeditorx}%その他のeditor情報がある場合の出力
    \setunit*{\printdelim{nameyeardelim}}}}%
  {\global\undef\bbx@lasthash}}%

%% 編集者名が先頭でない時の出力 %%
\renewbibmacro*{byeditor}{%
  \ifnameundef{editor}{}{% 編者がいない（または先頭に出力済みの）ときは，保留中の区切りを変えない
    \usebibmacro{bbx:byeditor}{editor}%
    \usebibmacro{byeditorx}%
    \setunit{\printdelim{titledelim}}}%
}%

\renewbibmacro*{byeditor+others}{%
  \usebibmacro{bbx:byeditor}{editor+othersstrg}}

%% その他のeditor情報がある場合の出力 %%
\renewbibmacro*{byeditorx}{%
  \newunit%
  \usebibmacro{bbx:byeditor}{editora}%
  \newunit%
  \usebibmacro{bbx:byeditor}{editorb}%
  \newunit%
  \usebibmacro{bbx:byeditor}{editorc}%
}

%% 先頭でないeditorを出力する本体, editraもこちらで処理
\newbibmacro*{bbx:byeditor}[1]{%
  \ifnameundef{#1}{}%もし#1が存在していたら
    {\printnames[byeditor]{#1}%#1を出力
    \setunit{\printdelim{editortypedelim}}%namestringとの間のデリム
    \usebibmacro{namestrg}{#1}%namestring
    }%
}%

%%% 翻訳者 %%%
% 翻訳者を出力するコマンド, translatoraがある場合の処理も同梱
\renewbibmacro*{translator}{%翻訳者は常にデフォルトの順番で出力する
  \usebibmacro{bbx:bytranslator}{translator}%
  \newunit%
  \ifnameundef{translatora}{}{\usebibmacro{bbx:bytranslator}{translatora}}%
  \setunit{\printdelim{nameyeardelim}}%
}%

% 翻訳者を出力するコマンドの本体。defaultの順番で出力するコマンド。
\newbibmacro*{bbx:bytranslator}[1]{%
  \printnames[default]{#1}%
  \setunit{\printdelim{translatortypedelim}}%
  \usebibmacro{namestrg}{#1}%
  \clearname{#1}%
}%

% translatorの「訳」などを出力, 引数にはtranslatorやtranslatoraなどが入る, translatortypeがあればそれを出力
\newbibmacro*{namestrg}[1]{%
  \printtext[#1type]{%%
    \iffieldundef{#1type}{%
      \ifboolexpr{%
        test {\ifnumgreater{\value{#1}}{1}}
        or
        test {\ifandothers{#1}}
      }
        {\bibstring{#1s}}%
        {\bibstring{#1}}}%
    {\ifbibxstring{\thefield{#1type}}%
      {\ifboolexpr{
        test {\ifnumgreater{\value{#1}}{1}}
        or
        test {\ifandothers{#1}}
      }
        {\bibstring{\thefield{#1type}s}}%
        {\bibstring{\thefield{#1type}}}}%
      {\thefield{#1type}}}}}%

%%% 書籍タイトル %%%

% 和文の版（第2版，新版）は書名に含め，半角スペースで区切る（ガイド 4.4(1)）。欧文は書名の後に別に出す。
\newbibmacro*{edition:cjk}{%
  \ifbool{CJK}
    {\iffieldundef{edition}{}{\setunit{\addspace}\printfield{edition}\clearfield{edition}}}
    {}}

% 叢書名（series）は和文だけ書名の前に出す（『講座社会学 12 環境』）。欧文では出さない（2026-10-24 決定）
\newcommand*{\jsr@ifseries}{%
  \ifboolexpr{ bool {CJK} and not test {\iffieldundef{series}} }}
\renewbibmacro*{series+number}{%
  \printfield{series}%
  \setunit*{\addspace}%
  \printfield{number}}

\newbibmacro*{volume+part}{%
  \printfield{volume}%
  \printfield{part}}

\newbibmacro*{fhdtitle}[1]{%
  \printtext[fhdkakko]{%
    \jsr@ifseries{\usebibmacro{series+number}\setunit*{\addspace}}{}%
    \usebibmacro{printtitle}{#1}%
  }%
  \setunit{\printdelim{titledelim}}%
}%

%一重鍵かっこタイトル出力
\renewbibmacro*{title}{%一重鍵かっこの
  \ifboolexpr{ test {\iffieldundef{title}} and test {\iffieldundef{subtitle}} }
    {}{%
    \printtext[fhkakko]{%
      \usebibmacro{printtitle}{}%
      \iffieldundef{titleaddon}%
        {}%
        {\setunit{\addspace\printfield{titleaddon}}}%
    }%
    \setunit{\printdelim{titledelim}}}}%

% 雑誌名の出力。ここではnumberがあったとしても誌名に出力させない。
\renewbibmacro*{journal}{%
  \ifboolexpr{ test {\iffieldundef{journaltitle}} and test {\iffieldundef{journalsubtitle}} }
    {}{%
    \printtext[journaltitle]{%
      \usebibmacro{printtitle}{journal}%
      \iffieldundef{journaltitleaddon}%
        {}%
        {\printfield{journaltitleaddon}}%
    }%
    \setunit{\printdelim{titledelim}}%
  }%
}%

% タイトル出力の本体マクロ。引数には何のタイトルを出力するのか(main, book)が入る
\newbibmacro*{printtitle}[1]{%
  \printfield[titlecase]{#1title}%
  \setunit{\subtitlepunct}%
  \printfield[titlecase]{#1subtitle}%
}%

%% book, collectionがmvであったときのためのmaintitleの処理
\renewbibmacro*{maintitle+title}{%
  \iffieldsequal{maintitle}{title}{%
    \clearfield{maintitle}%
    \clearfield{mainsubtitle}%
    \clearfield{maintitleaddon}%
  }{}%
  \ifboolexpr{%
    ( test {\iffieldundef{maintitle}} and test {\iffieldundef{mainsubtitle}} )
    and
    ( test {\iffieldundef{title}} and test {\iffieldundef{subtitle}} )
    }{}{%
    \printtext[fhdkakko]{%
      \iffieldundef{maintitle}{%
        % 単独の巻：『書名 第3巻』
        \jsr@ifseries{%
          \usebibmacro{series+number}%
          \setunit{\addspace}%
        }{}%
        \iffieldundef{title}{}{%
          \usebibmacro*{printtitle}{}%
        }%
        \usebibmacro{edition:cjk}%
        \iffieldundef{volume}{}{%
          \setunit{\addspace}%
          \usebibmacro{volume+part}%
        }%
      }{%
        % 多巻本の1巻：『総書名 第3巻 巻の書名』
        \usebibmacro*{printtitle}{main}%
        \setunit{\addspace}%
        \iffieldundef{volume}{}{%
          \usebibmacro{volume+part}%
          \setunit{\addspace}%
        }%
        \jsr@ifseries{%
          \usebibmacro{series+number}%
          \setunit{\addspace}%
        }{}%
        \iffieldundef{title}{}{%
          \usebibmacro*{printtitle}{}%
        }%
        \usebibmacro{edition:cjk}%
      }%
    }%
    \setunit{\printdelim{titledelim}}%
  }%
}%
%% inbook, incollectionがbooktitleもmaintitleも得た場合の処理
\renewbibmacro*{maintitle+booktitle}{%%
  \ifboolexpr{%
    ( test {\iffieldundef{maintitle}} and test {\iffieldundef{mainsubtitle}} )
    and
    ( test {\iffieldundef{booktitle}} and test {\iffieldundef{booksubtitle}} )
  }{}{%
    \printtext[fhdkakko]{%
      \iffieldundef{maintitle}{}{%
        \usebibmacro*{printtitle}{main}%
        \setunit{\addspace}%
      }%
      \iffieldundef{volume}{}{%
        \usebibmacro{volume+part}%
        \setunit{\addspace}%
      }%
      \jsr@ifseries{%
        \usebibmacro{series+number}%
        \setunit{\addspace}%
      }{}%
      \iffieldundef{booktitle}{}{%
        \usebibmacro*{printtitle}{book}%
      }%
      \usebibmacro{edition:cjk}%
    }%
    \setunit{\printdelim{titledelim}}%
  }%
}%

%%% 電子書籍（ガイド 4.5.1）%%%
% 紙媒体の刊行年・出版社は origdate＋origpublisher で書く。書名の後に出す。
%   和文：『タイトル』（2005，日本放送出版協会刊），電子媒体出版社，…
%   欧文：Title (2005, Washington, DC: Publisher), …（所在地は origlocation）。和文では origlocation は出さない
% origpublisher があるときは，再刊の [初版年] 形式にしない（originaldate、cite:origyear）。
\newbibmacro*{ebook:orig}{%
  \iflistundef{origpublisher}{}{%
    \printtext[fhparens]{%
      \thefield{origyear}%
      \ifthenelse{\boolean{CJK}}
        {\printdelim{fhcomma}\printlist{origpublisher}\bibstring{origpublished}}
        {\addcomma\space
         \iflistundef{origlocation}{}{\printlist{origlocation}\addcolon\space}%
         \printlist{origpublisher}}}%
    \setunit{\printdelim{fhcomma}}}}
% フォーマット（Kindle版，Available on CD-ROM only など）は note に書き，末尾の括弧に出す
\newbibmacro*{ebook:note}{%
  \iffieldundef{note}{}{%
    \setunit*{\printdelim{fhcomma}}%
    \printtext[fhparens]{\printfield{note}}}}

%%% doiと取得日 %%%
% 表示マクロ
% 取得日があるときは（取得日，DOI／URL）。取得日がなくても，doi=true なら DOI だけを（DOI）の形で出す
\newbibmacro*{urldate+eprint/doi/url}{%
  \iffieldundef{urlyear}
    {\iftoggle{bbx:doi}
       {\iffieldundef{doi}{}{\printtext[fhparens]{\printfield{doi}}}}
       {}}
    {\printtext[fhparens]{%
       \printtext{\printurldate}%
       \newunit%
       \usebibmacro{eprint/doi/url}%
     }}%
}%

%%% データベースまたはdoiまたはurl %%%
\newbibmacro*{eprint/doi/url}{%
  \iffieldundef{eprinttype}{%
    \iffieldundef{doi}{%
      \printfield{url}%
    }{%
      \printfield{doi}%
    }%
  }{%
    \printfield{eprinttype}%
  }%
}%

%%% 巻号 %%%
%% 巻号設定 %%
% volume(number)が基本
% numberだけある場合（第○号など）はnumberのみ
\newbibmacro*{volume+issues}{%
  \iffieldundef{volume}%
    {\printfield{number}}%
    {\printfield{volume}\printfield[parens]{number}}%
}%

% 欧文の新聞のページの接頭辞（p. A1，pp. A1-A3）。biblatex の \mkpageprefix は A1 のような数字でないページには付けないので，
% ページが範囲か（\bibrangedash を含むか）を調べて自前で付ける。
\def\jsr@pgprefix{%
  \edef\jsr@tmppages{\thefield{pages}}%
  \expandafter\jsr@pgprefix@i\jsr@tmppages\bibrangedash\relax\@nil}
\def\jsr@pgprefix@i#1\bibrangedash#2\@nil{%
  \ifx\relax#2\relax\bibstring{page}\else\bibstring{pages}\fi\ppspace}

% 新聞：和文は 朝刊・夕刊（issue），版・地域版（note），ページ＋「面」。欧文は p. A1（ASA）
\newbibmacro*{pages}{%
  \iffieldundef{pages}{}{%
    \jsr@ifnewspaper{%
      \ifthenelse{\boolean{CJK}}{%
        \setunit{\unspace}%
        \printfield{issue}%
        \newunit%
        \printfield{note}%
        \newunit%
        \printtext{\printfield{pages}\bibstring{newspaperpage}}%
      }{%
        \setunit{\addcomma\space}%
        \printtext{\jsr@pgprefix\printfield{pages}}%
      }%
    }{%
      \printfield{pages}%
      \newunit%
    }
  }
}%

% 新聞・雑誌の日付。和文は 1958年8月10日，欧文は November 3（年は著者の後に出している。ASA）
\newbibmacro*{news:date}{%
  \ifthenelse{\boolean{CJK}}
    {\printdate}
    {\printtext{\mkbibmonth{\thefield{month}}%
       \iffieldundef{day}{}{\addspace\stripzeros{\thefield{day}}}}}}

%% 巻数・引用ページ表示マクロ %%%
\newbibmacro*{vol+pages}{%
  \iffieldundef{howpublished}{%
    \usebibmacro{volume+issues}%
    \setunit{\addcolon\space}%
    \usebibmacro{pages}%
  }{%
    \printtext{\ifthenelse{\boolean{CJK}}%
      {\addspace}%
      {\adddot}%
    \printfield{howpublished}%
    }%
  }%
}%

%%% 書籍の Vol. の処理（1冊）%%%
\newbibmacro*{volume:book}%
  {\iffieldundef{volume}{}%
    {\ifthenelse{\boolean{CJK}}%
      {\unspace\printtext[fparens]{\strfield{volume}}}%
      {\addspace\printtext[parens]{\strfield{volume}}}}}%


%%% 発行元（社会学評論スタイルガイド 4.4(9)）
%%% ガイドは，発行元が著者・編者・機関名と同一の場合や「国立印刷局」の場合に「省略してよい」としている。
%%% 場合分けが難しく，民間の機関が編者・発行元を兼ねる文献（例：毎日新聞社編・毎日新聞社刊）では
%%% 発行元を示したほうがよいため，スタイルは発行元を自動では省略しない（書いたものは常に出す）。
%%% 省略したいときは，bib ファイルの publisher を書かない。
% \savebox の中で \printnames を使う処理のために，その間だけ句読点の状態
% （\setunit で保留中の区切りなど）を退避する。退避しないと保留中の区切りが箱の中で消費される。
\def\jsr@punctstates{block,unit,insert,lastins,keepunit}%
\def\jsr@savepunct@i#1{\iftoggle{blx@#1}
  {\global\csletcs{jsr@sv@#1}{@firstoftwo}}
  {\global\csletcs{jsr@sv@#1}{@secondoftwo}}}%
\def\jsr@restorepunct@i#1{%
  \csuse{jsr@sv@#1}{\global\toggletrue{blx@#1}}{\global\togglefalse{blx@#1}}}%
\def\jsr@savepunct{%
  \global\let\jsr@sv@unitpunct\blx@unitpunct
  \expandafter\forcsvlist\expandafter\jsr@savepunct@i\expandafter{\jsr@punctstates}}%
\def\jsr@restorepunct{%
  \global\let\blx@unitpunct\jsr@sv@unitpunct
  \expandafter\forcsvlist\expandafter\jsr@restorepunct@i\expandafter{\jsr@punctstates}}%
\newbibmacro*{publisher:print}{%
  \printlist{publisher}}%

%%% 書籍の Vol. の処理（複数冊）%%%
% 和文：『書名』（全10巻），欧文：Title, 10 vols.（「全」「巻」「vols.」は bibstring：totalprefix、totalvolumes）
\newbibmacro*{volumes}%
  {\iffieldundef{volumes}{}%
    {\ifthenelse{\boolean{CJK}}%
      {\setunit{}\printtext[fparens]{\bibstring{totalprefix}\strfield{volumes}\bibstring{totalvolumes}}}% 書名の後の保留中の区切り（副題のダッシュ）を消す
      {\setunit{\addcomma\space}\printtext{\strfield{volumes}\addspace\bibstring{totalvolumes}}}}}%

%%% 新聞 %%%
\newbibmacro*{yyyymmdd}{%
  \iffieldundef{year}{}{%
    \printtext{%
      \thefield{year}%
      \iffieldundef{month}{}{.\stripzeros{\thefield{month}}}%
      \iffieldundef{day}{}{.\stripzeros{\thefield{day}}}}}}%

%%% 機関 %%%
\newbibmacro*{type+institution}{%
  \ifthenelse{\boolean{CJK}}{%
    \printlist{institution}%
    \unspace
    \printfield{type}%
  }{%
    % 欧文（ASA）：PhD dissertation, University of …（括弧は付けない）
    \printfield{type}%
    \newunit%
    \printlist{institution}%
  }%
}%

% 報告書で，機関名を先頭の名前として出したか（出したなら，ここでは繰り返さない）
\newbool{jsr@instfirst}

\newbibmacro*{location+institution}{%
  \ifthenelse{\boolean{CJK}}{}{
  \printlist{location}%
  \ifboolexpr{ test {\iflistundef{institution}} or bool {jsr@instfirst} }
    {\setunit*{\addcomma\space}}
    {\setunit*{\addcolon\space}}%
  \ifbool{jsr@instfirst}{}{\printlist{institution}}%
  \setunit*{\addcomma\space}%
  \usebibmacro{date}%
  \newunit}}

% 欧文の報告書の種類と番号：Technical Report TR-12
\newbibmacro*{report:typenumber}{%
  \printfield{type}%
  \setunit*{\addspace}%
  \printfield{number}%
  \newunit}

% 報告書所収の論文（親の @report を crossref で指す @incollection）で，書名の後に出す報告書の情報。
% 親から引き継いだ institution があるときだけ出す。
%   和文：『書名』1995-1996年度科学研究費補助金研究成果報告書（課題番号），金沢大学文学部，
%   欧文：Title, Technical Report TR-12, Chicago: University of Chicago,
\newbool{jsr@locdone}% 欧文の報告書所収論文で，出版地を機関名の前に出したか（出したなら incollection では繰り返さない）
\newbibmacro*{report:parent}{%
  \global\boolfalse{jsr@locdone}%
  \iflistundef{institution}{}{%
    \ifthenelse{\boolean{CJK}}
      {\printfield{type}%
       \ifboolexpr{ test {\iffieldundef{number}} or not test {\iffieldundef{series}} }
         {}{\printtext[fparens]{\printfield{number}}}%
       \newunit
       \printlist{institution}}
      {\usebibmacro{report:typenumber}%
       \iflistundef{location}{}{%
         \printlist{location}%
         \setunit*{\addcolon\space}%
         \global\booltrue{jsr@locdone}}%
       \printlist{institution}}%
    \setunit*{\printdelim{fhcomma}}}}

%%% 学会報告 %%%
% 和文：報告者名，大会開催年，「報告のタイトル」第○回日本社会学会大会報告原稿．
%   eventtitle に「報告原稿」まで書いてよい。type を書いたときだけ eventtitle の後に続ける
%   （「報告原稿」を補わない。2026-10-24 決定）。
% 欧文（ASA）：Author, year, “Title,” Paper presented at the Annual Meeting of …, August 22, Chicago, IL.
%   「Paper presented at the」は bibstring（paperpresented）。type を書いたときは type で置き換える。
%   開催日は eventdate の月日（年は著者の後に出している）、開催地は venue。
\newbibmacro*{conference}{%
  \usebibmacro{author}%
  \usebibmacro{date+extradate}%
  \usebibmacro{title}%
  \ifthenelse{\boolean{CJK}}
    {\printfield{eventtitle}%
     \printfield{type}}
    {\iffieldundef{eventtitle}{}{%
       \iffieldundef{type}
         {\printtext{\bibstring{paperpresented}}}
         {\printfield{type}}%
       \setunit*{\addspace}%
       \printfield{eventtitle}%
       \iffieldundef{eventmonth}{}{%
         \setunit*{\addcomma\space}%
         \printtext{\mkbibmonth{\thefield{eventmonth}}%
           \iffieldundef{eventday}{}{\addspace\stripzeros{\thefield{eventday}}}}}%
       \setunit*{\addcomma\space}%
       \printfield{venue}}}}

%%% 学会開催地 %%%
\newbibmacro*{location}{%
  \ifthenelse{\boolean{CJK}}{%
    \nopunct
    \mkbibparens{\strfirstlistitem{location}}%
%    \mkbibparens{\printlist{location}}%
  }{%
    \printlist{location}%
  }%
}%

%% origdate記入における再販情報 %%
\newbibmacro*{originaldate}{%
  \ifbool{bbx:reissue}
    {% 再刊：原典の年（extradate を含む）を角カッコで示す
     \printtext[brackets]{%
       \jsr@orig@year
       \ifdefvoid\jsr@orig@extradate{}{\mknumalph{\jsr@orig@extradate}}}\addthinspace}%
    {\ifboolexpr{ test {\iffieldundef{origyear}} or not test {\iffieldundef{related}}
                   or not test {\iflistundef{origpublisher}}
                   or ( not test {\ifnameundef{translator}} and not test {\ifnameundef{author}} ) }{}{%
       \printtext[brackets]{%
         \thefield{origyear}%
       }\addthinspace}}%
}%


%%% 情報処理用マクロ %%%
%%% 書籍 %%%
\newbibmacro*{book}{%
  \unspace%
  \usebibmacro{translator/author/editor}%著者など
  \usebibmacro{originaldate}% 初出を出力
  \usebibmacro{date+extradate}% 出版年
  % 表題
  %\usebibmacro{title}{fhdkakko}{}%
  \usebibmacro{maintitle+title}%
  % 電子書籍の場合の処理
  \usebibmacro{ebook:orig}%
  % 版数
  \ifthenelse{\boolean{CJK}}{}%
    {\printfield{edition}%
    \newunit}%
  % 単独の訳書の訳者（原典のエントリがない訳書）
  \usebibmacro{translator:after}%
  % 出版都市名
  \ifthenelse{\boolean{CJK}}{}%
    {\printlist{location}%
    \setunit*{\addcolon\space}}%
  % 出版社（著者・編者と同じなら省く）
  \usebibmacro{publisher:print}%
  % 電子書籍など：取得日があるときだけ（取得日，URL）を出す。フォーマットは note
  \setunit*{\printdelim{fhcomma}}%
  \usebibmacro{urldate+eprint/doi/url}%
  \usebibmacro{ebook:note}%
  \printdelim{findelim}%
}%

%%% 雑誌 %%%
\newbibmacro*{article}{%
  \unspace%
  \usebibmacro{translator/author/editor}%
  \usebibmacro{originaldate}% 初出を出力
  \usebibmacro{date+extradate}% 出版年
  % 表題
  \usebibmacro{title}%
  % 誌名
  \usebibmacro{journal}%
  % 発行元：和文誌で書かれていれば出す（『三色旗』慶應通信）。欧文誌では出さない（ガイド 4.4(5)，2026-10-24 決定）
  \ifthenelse{\boolean{CJK}}{\printlist{publisher}}{}%
  \setunit*{\printdelim{fhcomma}}%
  %\usebibmacro{yyyymmdd}%
  % 新聞・雑誌の日付は，月があるときだけ出す（年だけの記事では，著者の後の年と重複する）
  \jsr@ifnewsmag{\iffieldundef{month}{}{\usebibmacro{news:date}\newunit}}{}%
  % 巻数・引用ページ（オンライン早期公開かどうかを確認してから処理）
  \usebibmacro{vol+pages}%
  % doi,url,database
  \newunit%
  \usebibmacro{urldate+eprint/doi/url}%
  \printdelim{findelim}%
}%


%%% 雑誌の号全体（特集号。@periodical）%%%
% 和文：編者，刊行年，「特集 特集名」『誌名』巻(号)．
% 欧文：Editor ed., year, "Issue title," Special issue, Journal, vol(no).
% スタイルガイドに規定がないので，APA 第7版 10.1 の例12 と Chicago の special issue に倣った jsr の決定（2026-10-25）。
% bib は biblatex 標準のとおり（title が誌名，issuetitle が特集名，editor が編集主体）。
% 編者（と著者）がないときは名前を出さず，誌名の後に年を出す（「特集 X」『誌名』39(2)，1988）。
\newbool{jsr@pernoname}
\newbibmacro*{periodical}{%
  \unspace%
  \ifboolexpr{ test {\ifnameundef{author}} and test {\ifnameundef{editor}} }
    {\booltrue{jsr@pernoname}}{\boolfalse{jsr@pernoname}}%
  \usebibmacro{translator/author/editor}%
  \ifbool{jsr@pernoname}{}{\usebibmacro{date+extradate}}%
  \usebibmacro{periodical:issuetitle}%
  \usebibmacro{periodical:title}%
  \usebibmacro{vol+pages}%
  \ifbool{jsr@pernoname}%
    {\setunit{\printdelim{fhcomma}}\usebibmacro{date+extradate}}{}%
  \newunit%
  \usebibmacro{urldate+eprint/doi/url}%
  \printdelim{findelim}%
}%
% 特集名：和文は「特集 X」（標識は鉤括弧の中，半角空白），欧文は "X," Special issue,（標識は鉤括弧の後）
\newbibmacro*{periodical:issuetitle}{%
  \ifboolexpr{ test {\iffieldundef{issuetitle}} and test {\iffieldundef{issuesubtitle}} }
    {}{%
    \ifbool{CJK}
      {\printtext[fhkakko]{\bibstring{specialissue}\addspace\usebibmacro{printtitle}{issue}}%
       \setunit{\printdelim{titledelim}}}
      {\printtext[fhkakko]{\usebibmacro{printtitle}{issue}}%
       \setunit{\printdelim{titledelim}}%
       \printtext{\bibstring{specialissue}}%
       \setunit{\printdelim{fhcomma}}}}}
% 誌名（title）を，雑誌記事の誌名（journaltitle）と同じ書式で出す
\newbibmacro*{periodical:title}{%
  \ifboolexpr{ test {\iffieldundef{title}} and test {\iffieldundef{subtitle}} }
    {}{%
    \printtext[journaltitle]{\usebibmacro{printtitle}{}}%
    \setunit{\printdelim{titledelim}}}}

%%% 編書・共著本内論文 %%%
\newbibmacro*{incollection}{%
  \unspace%
  \usebibmacro{translator/author/editor}%% 著者名
  \setboolean{reversenamebool}{false}% 先頭の引用が終了したのでfalseに
  \usebibmacro{originaldate}% 初出を出力
  \usebibmacro{date+extradate}%
  % 表題
  \usebibmacro{title}%
  % 編集者名
  \usebibmacro{byeditor}%
  % 共著者名
  \usebibmacro{bybookauthor}%%
  % 編書・共著誌名
  %\usebibmacro{title}{fhdkakko}{book}%
  \usebibmacro{maintitle+booktitle}%
  %\setunit{\printdelim{titledelim}}%
  % 電子書籍の場合の処理
  \usebibmacro{ebook:orig}%
  % 欧文の版（和文は書名に含めた）
  \ifthenelse{\boolean{CJK}}{}%
    {\printfield{edition}%
    \newunit}%
  % 単独の訳書の訳者
  \usebibmacro{translator:after}%
  % 報告書所収の論文：報告書の種類・番号・研究機関名
  \usebibmacro{report:parent}%
  % 出版都市名（欧文の報告書では report:parent が出した）
  \ifthenelse{\boolean{CJK}}{}%
    {\ifbool{jsr@locdone}{}{%
       \printlist{location}%
       \setunit*{\addcolon\space}}}%
  % 出版社
  \usebibmacro{publisher:print}%
  \setunit*{\printdelim{fhcomma}}%
  % 巻数・引用ページ（オンライン早期公開かどうかを確認してから処理）
  \usebibmacro{pages}%
  % ダウンロード版の章など：取得日があるときだけ（取得日，URL）を出す。フォーマットは note
  \setunit*{\printdelim{fhcomma}}%
  \usebibmacro{urldate+eprint/doi/url}%
  \usebibmacro{ebook:note}%
  \printdelim{findelim}%
}%



%%% ==================================================================
%%% relatedフィールド出力（循環参照防止 + fieldformatによる書式制御）
%%% ==================================================================
%
% 【設計方針】
%  ・メインエントリ   ＝ 実際に参照した文献（訳書・再録編著書など）
%  ・related フィールド＝ その原典（原書・初出誌など）を指す entrykey
%  ・出力順序          ＝ 「related 先（原典）の完全な書誌情報」→
%                         「メインエントリ（訳書・再録編著書）の情報」
%                         （standard.bbx の「本体→related」とは逆順）
%  ・relatedtype       ＝ “メインエントリ側”をどう装飾するかを選ぶキー。
%                         \DeclareFieldFormat{related:<relatedtype>} で
%                         書式（丸カッコ・「再録：」等の接続語）を定義する。
%  ・循環参照防止       ＝ standard.bbx と同じ \ifrelatedloop の仕組み
%                         （bbx:relatedloop リストに entrykey を積む）を
%                         流用し，自己参照・相互参照による無限ループを防ぐ。
%

% relatedtype ごとのフィールドフォーマット定義
% （#1 には「メインエントリ（訳書・再録編著書）側」の内容が渡される）
\DeclareFieldFormat{related:default}{\mkbibfhparens{#1}}
\DeclareFieldFormat{related:translationof}{\mkbibfhparens{#1}}
\DeclareFieldFormat{related:reprintof}{%
  \ifthenelse{\boolean{CJK}}
    {\mkbibfparens{\bibstring{reprintin}\printdelim{fhcolon}#1}}
    {\bibstring{reprintin}\setunit{\printdelim{fhcolon}}#1}% 本文の先頭の \unspace で空白が消えないよう，区切りは保留にする
}

% relatedtype ごとに，メインエントリ側の直前に \relatedbool を立てて
% samedash（著者名のダッシュ省略）を抑制するかどうかを登録するリスト。
% 原典と再録書などで著者が同一になりやすいタイプをカンマ区切りで追加する。
\newcommand*{\jsr@relatedsamedashtypes}{reprintof}%

%% relatedフィールドの内容をエントリタイプに応じて出力するための共通マクロ %%
\newbibmacro*{book/incollection/article}{%
  \iffieldundef{journaltitle}%
    {\iffieldundef{booktitle}%
      {\usebibmacro{book}}%
      {\usebibmacro{incollection}}}%
    {\usebibmacro{article}}%
}

%%% relatedフィールドのディスパッチ入口 %%%

%%% related先（原典）を，循環参照を検出しながらレンダリングする %%%
\newbibmacro*{related:entry}{%
  \ifrelatedloop%
    {}% 既にこの entrykey を処理済み＝循環しているので何も出力しない
    {\listcsxadd{bbx:relatedloop}{\strfield{entrykey}}%
     \iffieldundef{clonesourcekey}
       {}
       {\listcsxadd{bbx:relatedloop}{\strfield{clonesourcekey}}}%
     \entrydata*{\thefield{related}}{%
       \usebibmacro{checkLang}%
       \usebibmacro{book/incollection/article}}}}%

%%% 汎用 related 出力マクロ（renewbibmacro） %%%
%  ①原典（related先）をフルレンダリング → ②区切り →
%  ③メインエントリ側を relatedtype に応じた fieldformat でラップ
\newbibmacro*{relatedfield}{%
  \usebibmacro{related:init}%
  \ifboolexpr{ test {\iffieldundef{related}} or test {\ifrelatedloop} }
    {}%
    {% ① 原典（related先）
     \usebibmacro{related:entry}%
     \setunit*{\printdelim{relatedpunct}}%
     \setboolean{reversenamebool}{false}% 原典の引用が終了したのでfalseに戻す
     \usebibmacro{checkLang}%
     % ② メインエントリ側で著者名ダッシュを抑制するか判定
     \xifinlist{\thefield{relatedtype}}{\jsr@relatedsamedashtypes}%
       {\setboolean{relatedbool}{true}}%同一著者のことが多いので抑制
       {}%
     % ③ relatedtype に対応する fieldformat が未定義ならdefaultへ
     \iffieldformatundef{related:\strfield{relatedtype}}%
       {\def\bbx@tempa{related:default}}%
       {\def\bbx@tempa{related:\strfield{relatedtype}}}%
     \printtext[\bbx@tempa]{%
       \usebibmacro{book/incollection/article}}%
     \setboolean{relatedbool}{false}}}%

%%% ==================================================================
%%% 訳書・再録を原典の項目に添える（社会学評論スタイルガイド 4.2(6)(8)，4.4(6)(7)）
%%% ==================================================================
%
% 【設計方針】
%  ・文献リストは「著作」単位で並べる。訳書・再録（related ＋ relatedtype が
%    translationof／reprintof のエントリ。以下「添え物」）は単独の項目にせず，
%    原典（related 先）の項目の後ろに添える。
%  ・原典の項目になるのは，原典が引用されていれば原典そのもの，引用されていなければ
%    biber が作る原典の複製（clone，relatedoptions は上の sourcemap で設定）。
%    これにより，並び順と extradate（a，b）は原典の著者・年・タイトルで決まる。
%  ・処理は .bbl の読み込み時に行う：
%     (1) \AtDataInput で，添え物・複製・extradate の情報を記録する。
%     (2) データリストの終わり（\blx@bbl@enddlist）で，添え物を印刷リストから除き，
%         extradate を振り直す（原典と複製，添え物の重複を数えない）。
%  ・related が解決できなかったエントリ（biber が related を消す）は添え物にならず，
%    通常どおり単独で印刷される。
%
\newcommand*{\jsr@pfx}{}% <refsection>@<datalist>
% リストがない（一度も登録されていない）ときは何もしないループ
% （etoolbox のループに未定義のリストを渡すと，\relax が項目として処理されてしまう）
\newcommand*{\jsr@forlistcs}[2]{\ifcsvoid{#2}{}{\forlistcsloop{#1}{#2}}}
\newcommand*{\jsr@dolistcs}[1]{\ifcsvoid{#1}{}{\dolistcsloop{#1}}}
\newcount\jsr@cnta
\newcount\jsr@cntb

% 現在のエントリが添え物か
\newcommand*{\jsr@ifattachment}{%
  \ifboolexpr{ not test {\iffieldundef{related}}
    and ( test {\iffieldequalstr{relatedtype}{translationof}}
          or test {\iffieldequalstr{relatedtype}{reprintof}} ) }}

% (1) 読み込み時の記録
\def\jsr@datainput{%
  % author がない article 型の項目は文献リストから外れる（sourcemap が skipbib を付ける）ので，警告はここで出す
  \iffieldequalstr{jsrnoauthor}{1}
    {\blx@warning@noline{jsr: entry '\abx@field@entrykey' has no author and is omitted from the bibliography\MessageBreak
       (add entrysubtype=newspaper/magazine if it is an unsigned article)}}
    {}%
  \edef\jsr@pfx{\the\c@refsection @\blx@dlist@name}%
  \edef\jsr@key{\abx@field@entrykey}%
  % 添え物：原典（複製）のキーごとに，添え物のキーを登録する
  \jsr@ifattachment
    {\listcsxadd{jsr@reps@\jsr@pfx}{\jsr@key}%
     \def\do##1{%
       \xifinlistcs{\jsr@key}{jsr@attach@\the\c@refsection @##1}{}%
         {\listcsxadd{jsr@attach@\the\c@refsection @##1}{\jsr@key}}}%
     \expandafter\docsvlist\expandafter{\abx@field@related}}%
    {}%
  % 複製：原典のキー → 複製のキー。原典も引用されていれば（skipbib），複製は影
  \iffieldundef{clonesourcekey}{}{%
    \csxdef{jsr@cloneof@\the\c@refsection @\abx@field@clonesourcekey}{\jsr@key}%
    \iftoggle{blx@skipbib}
      {\listcsxadd{jsr@shadows@\jsr@pfx}{\jsr@key}%
       \csxdef{jsr@shadowsrc@\jsr@pfx @\jsr@key}{\abx@field@clonesourcekey}}%
      {}}%
  % extradate の組（名前ハッシュ／年／名前の種類）。ガイド 4.4：a，b は「同一著者の同一カテゴリーの
  % 同一年度」で付ける。biber は著書と編書（佐藤 1991／佐藤編 1991）を同じ組で数えるので，名前の種類で分ける
  \iffieldundef{extradate}{}{%
    \edef\jsr@grp{\abx@field@namehash/%
      \csuse{abx@field@\abx@field@labeldatesource year}/\abx@field@labelnamesource}%
    \ifcsdef{jsr@edg@\jsr@pfx @\jsr@grp}{}%
      {\listcsxadd{jsr@edgroups@\jsr@pfx}{\jsr@grp}}%
    \listcsxadd{jsr@edg@\jsr@pfx @\jsr@grp}{\jsr@key}}}
\AtDataInput{%
  \expandafter\ifstrequal\expandafter{\blx@dlist@type}{entry}{\jsr@datainput}{}}

% (2) データリストの終わりの処理
\def\jsr@ifshadow#1{%
  \xifinlistcs{#1}{jsr@reps@\jsr@pfx}
    {\@firstoftwo}
    {\xifinlistcs{#1}{jsr@shadows@\jsr@pfx}}}
% 読み込んだデータを書き換える（値が空なら extradate を消す）
\def\jsr@setextradate#1#2{%
  \csxdef{jsr@ed@\jsr@pfx @#1}{#2}%
  \ifstrempty{#2}
    {\csgappto{blx@data@\jsr@pfx @#1}{\undef\abx@field@extradate}}
    {\edef\jsr@tmp{\noexpand\csgappto{blx@data@\jsr@pfx @#1}%
       {\noexpand\def\noexpand\abx@field@extradate{#2}}}%
     \jsr@tmp}}
\def\jsr@countmember#1{%
  \jsr@ifshadow{#1}{\def\jsr@hasshadow{1}}{\advance\jsr@cnta\@ne}}
\def\jsr@assignmember#1{%
  \jsr@ifshadow{#1}{}{%
    \advance\jsr@cntb\@ne
    \ifnum\jsr@cnta>\@ne
      \jsr@setextradate{#1}{\the\jsr@cntb}%
    \else
      \jsr@setextradate{#1}{}%
    \fi}}
% 組ごとに，影（原典と重複する複製）と添え物を除いて振り直す（1つだけなら extradate を消す）
\def\jsr@renumgroup#1{%
  \jsr@cnta\z@
  \def\jsr@hasshadow{0}%
  \jsr@forlistcs{\jsr@countmember}{jsr@edg@\jsr@pfx @#1}%
  \jsr@cntb\z@
  \jsr@forlistcs{\jsr@assignmember}{jsr@edg@\jsr@pfx @#1}}
% 影の複製は原典と同じ値にする（訳書の文献注は複製の値を使うため）
\def\jsr@shadowfix#1{%
  \edef\jsr@src{\csuse{jsr@shadowsrc@\jsr@pfx @#1}}%
  \ifcsdef{jsr@ed@\jsr@pfx @\jsr@src}
    {\edef\jsr@tmp{\noexpand\jsr@setextradate{#1}{\csuse{jsr@ed@\jsr@pfx @\jsr@src}}}%
     \jsr@tmp}
    {}}
\def\jsr@finishlist{%
  \edef\jsr@pfx{\the\c@refsection @\blx@dlist@name}%
  % 添え物を印刷リストから除く
  \def\do##1{\listcsgremove{blx@dlist@entry@\jsr@pfx}{##1}}%
  \jsr@dolistcs{jsr@reps@\jsr@pfx}%
  % extradate の振り直し
  \jsr@forlistcs{\jsr@renumgroup}{jsr@edgroups@\jsr@pfx}%
  \jsr@forlistcs{\jsr@shadowfix}{jsr@shadows@\jsr@pfx}%
  \def\do##1{\jsr@setextradate{##1}{}}%
  \jsr@dolistcs{jsr@reps@\jsr@pfx}}
\pretocmd\blx@bbl@enddlist
  {\expandafter\ifstrequal\expandafter{\blx@dlist@type}{entry}{\jsr@finishlist}{}}
  {}
  {\blx@warning@noline{jsr: could not patch \string\blx@bbl@enddlist}}

%%% 添え物の出力 %%%
\newbool{bbx:reissue}% 再刊（原典が書籍）を原典の位置に出力中
\newbool{bbx:inattach}% 添え物を出力中
% 現在のエントリ（原典または複製）の添え物のリストを \jsr@attachlist に集める
\newcommand*{\jsr@collectattach}{%
  \let\jsr@attachlist\@empty
  \edef\jsr@tmpkey{\thefield{entrykey}}%
  \def\do##1{\listxadd\jsr@attachlist{##1}}%
  \jsr@dolistcs{jsr@attach@\the\c@refsection @\jsr@tmpkey}%
  \ifcsdef{jsr@cloneof@\the\c@refsection @\jsr@tmpkey}
    {\edef\jsr@tmpkey{\csuse{jsr@cloneof@\the\c@refsection @\jsr@tmpkey}}%
     \jsr@dolistcs{jsr@attach@\the\c@refsection @\jsr@tmpkey}}
    {}}
% 書籍型か（再刊の判定に使う）
\newcommand*{\jsr@ifbooklike}{%
  \ifboolexpr{ test {\ifentrytype{book}} or test {\ifentrytype{collection}}
    or test {\ifentrytype{mvbook}} or test {\ifentrytype{mvcollection}} }}
% 原典の値と同じか（両方とも未定義も同じとみなす）
\newcommand*{\jsr@iffieldsame}[2]{%
  \ifboolexpr{ ( test {\iffieldundef{#1}} and test {\ifundef#2} )
    or test {\iffieldequals{#1}{#2}} }}

% 原典（または複製）の項目の本体。#1 は原典の書式マクロ（book／incollection／article）
\newbibmacro*{jsr:work}[1]{%
  \jsr@collectattach
  % 原典の情報を保存しておく（添え物の省略判定と再刊の年表示に使う）
  \savefield{authorfullhash}{\jsr@orig@author}%
  \savefield{title}{\jsr@orig@title}%
  \savefield{subtitle}{\jsr@orig@subtitle}%
  \savefield{year}{\jsr@orig@year}%
  \savefield{extradate}{\jsr@orig@extradate}%
  % 原典が書籍で，同じタイトル・サブタイトルの再録（reprintof）の添え物があれば，
  % それを原典の位置に出す（再刊：[初版年] 手元の版年）。タイトルが変わっていれば
  % 原典の書誌を残し，（再録：…）の形で添える
  \let\jsr@reissue\@empty
  \jsr@ifbooklike
    {\def\do##1{%
       \ifdefempty\jsr@reissue
         {\entrydata{##1}{%
            \ifboolexpr{ test {\iffieldequalstr{relatedtype}{reprintof}}
                          and test {\jsr@iffieldsame{title}{\jsr@orig@title}}
                          and test {\jsr@iffieldsame{subtitle}{\jsr@orig@subtitle}} }
              {\gdef\jsr@reissue{##1}}{}}}%
         {}}%
     \dolistloop\jsr@attachlist}
    {}%
  \ifdefempty\jsr@reissue
    {\usebibmacro{#1}}
    {\let\jsr@tmpkey\jsr@reissue
     \entrydata*{\jsr@tmpkey}{%
       \usebibmacro{checkLang}%
       \booltrue{bbx:reissue}%
       \usebibmacro{book/incollection/article}%
       \boolfalse{bbx:reissue}}%
     \usebibmacro{checkLang}}%
  % 残りの添え物
  \ifdef\bbx@lasthash{\let\jsr@savedhash\bbx@lasthash}{\undef\jsr@savedhash}%
  \booltrue{bbx:inattach}%
  \setboolean{reversenamebool}{false}%
  \forlistloop{\jsr@printattach}{\jsr@attachlist}%
  \boolfalse{bbx:inattach}%
  \ifdef\jsr@savedhash{\global\let\bbx@lasthash\jsr@savedhash}{\global\undef\bbx@lasthash}%
}

\def\jsr@printattach#1{%
  \ifboolexpr{ test {\ifdefstring{\jsr@reissue}{#1}} }{}{%
    \setunit*{\printdelim{relatedpunct}}%
    \entrydata*{#1}{%
      \usebibmacro{checkLang}%
      \jsr@scankata
      \global\undef\bbx@lasthash% 原典との同一著者ダッシュを出さない
      \iffieldformatundef{related:\strfield{relatedtype}}%
        {\def\bbx@tempa{related:default}}%
        {\def\bbx@tempa{related:\strfield{relatedtype}}}%
      \printtext[\bbx@tempa]{\usebibmacro{jsr:attachbody}}}}}

% 添え物の本文。再録は，原典と同じ著者・タイトルを省く（著者を省いたときは編者が先頭になる）
\newbibmacro*{jsr:attachbody}{%
  \iffieldequalstr{relatedtype}{reprintof}
    {\ifboolexpr{ not test {\ifnameundef{author}}
                  and test {\jsr@iffieldsame{authorfullhash}{\jsr@orig@author}} }
       {\clearname{author}}{}%
     \ifboolexpr{ test {\jsr@iffieldsame{title}{\jsr@orig@title}}
                  and test {\jsr@iffieldsame{subtitle}{\jsr@orig@subtitle}} }
       {\clearfield{title}\clearfield{subtitle}}{}}
    {}%
  \usebibmacro{book/incollection/article}}

% related を原典の項目として扱わない場合（related がない，または多巻本の親を指すだけ）
\newcommand*{\jsr@ifplainrelated}{%
  \ifboolexpr{ test {\iffieldundef{related}}
    or test {\iffieldequalstr{relatedtype}{mvbook}}
    or test {\iffieldequalstr{relatedtype}{multivolume}} }}

%%%%%% 文献タイプ別書式　%%%%%%

%%% 4.2 欧文の文献 4.4 邦文の文献共通
%% (1-3)単著・共著・編書
\DeclareBibliographyDriver{book}{%
  \usebibmacro{begentry}%
  \jsr@ifplainrelated%
    {\usebibmacro{jsr:work}{book}}%
    {\usebibmacro{relatedfield}}%
  \nopunct%
  %\usebibmacro{finentry}%
}%
%% 論文集など。authorがおらずedtorがいる場合がこちらになる。
\DeclareBibliographyAlias{collection}{book}%

%% (4)編書論文など（共著内の論文を含む）
%% biblatexではこのあたりを厳密に分けている。incollectionは著者がいない論文集(collection)のなかの一論文。
\DeclareBibliographyDriver{incollection}{%
  \usebibmacro{begentry}%
  \jsr@ifplainrelated% relatedフィールドに値なし
    {\usebibmacro{jsr:work}{incollection}}%
    {\usebibmacro{relatedfield}}%
  \nopunct%
  %\usebibmacro{finentry}%
}%
%% 全集など同じ著者の作品が集められているものの中の一つ。基本的にはauthorとbookauthorが同じ。
\DeclareBibliographyAlias{inbook}{incollection}%

%% (5)雑誌論文
\DeclareBibliographyDriver{article}{%
  \usebibmacro{begentry}%
  \ifnameundef{author}{}% 著者情報がない場合は文献リストに記載しない
  {\jsr@ifplainrelated% relatedフィールドに値なし
    {\usebibmacro{jsr:work}{article}}%
    {\usebibmacro{relatedfield}}}%
  \nopunct%
  %\usebibmacro{finentry}%
}%

%% 雑誌の号全体（特集号）。related は扱わない
\DeclareBibliographyDriver{periodical}{%
  \usebibmacro{begentry}%
  \usebibmacro{periodical}%
  \nopunct%
}%

%%% 以上の3つで(6)翻訳、(7)初出情報などに対応


%% (8)調査報告書, (9)政府刊行物など（紙媒体・オンライン取得の両方に対応）
%%  和文：著者名，刊行年，『課題名』報告書の種類（課題番号），研究機関名．
%%         type に「科研費研究成果報告書（課題番号…）」のように丸ごと書いてもよい。
\DeclareBibliographyDriver{report}{%
  \usebibmacro{begentry}%
  % 先頭の名前：著者 → 編者（研究分担者がいるときの研究代表者。「編」を付ける）→ 機関名の順に選ぶ
  \ifboolexpr{ test {\ifnameundef{author}} and test {\ifnameundef{editor}} }
    {\booltrue{jsr@instfirst}}
    {\boolfalse{jsr@instfirst}}%
  \ifnameundef{author}{%
    \ifnameundef{editor}{%
      \iflistundef{institution}{}{\printlist{institution}}%
    }{%
      \usebibmacro{editor}%
    }%
  }{%
    \usebibmacro{author}%
  }%
  \newunit%
  % 刊行年
  \usebibmacro{date+extradate}%
  \newunit%
  % 表題
  \usebibmacro{maintitle+title}%
  % 報告書の種類・課題番号・研究機関名
  %  和文：『課題名』報告書の種類（課題番号），研究機関名
  %  欧文：Title, Technical Report TR-12, 所在地: 機関名
  \ifthenelse{\boolean{CJK}}{%
    \printfield{type}%
    \iffieldundef{number}{}{\printtext[fparens]{\printfield{number}}}%
    \ifbool{jsr@instfirst}{}{%
      \iflistundef{institution}{}{\newunit\printlist{institution}}}%
  }{%
    \usebibmacro{report:typenumber}%
  }%
  % 発行元
  %  著者・機関名や「国立印刷局」と同一でも省略しない（社会学評論スタイルガイド 4.4(9)参照）。
  \iflistundef{publisher}{}{%
    \setunit*{\addhnspace}%
    \usebibmacro{publisher:print}%
  }%
  \newunit%
  \usebibmacro{location+institution}%
  % 取得日・URL（オンラインで取得した場合のみ出力。urldate/urlが未指定なら何も出力しない）
  \newunit%
  \usebibmacro{urldate+eprint/doi/url}%
  \usebibmacro{finentry}%
}%

%% (10)修士論文や博士論文
\DeclareBibliographyDriver{thesis}{%
  \usebibmacro{begentry}%
  % 著者名，授与年
  \usebibmacro{author}%
  \usebibmacro{date+extradate}%
  % 表題
  \usebibmacro{title}%
  % 大学名修士／博士論文
  \usebibmacro{type+institution}%
  \usebibmacro{finentry}%
}%

%% (10)学会報告原稿・予稿集の論文
%%  booktitle があれば，刊行された予稿集の論文として編書論文（incollection）と同じ形で出す。
%%  booktitle がなく eventtitle だけなら，学会報告として出す（conference）。
%%  @unpublished（未刊行の口頭報告）も同じ書式にする。
\DeclareBibliographyDriver{inproceedings}{%
  \usebibmacro{begentry}%
  \iffieldundef{booktitle}
    {\usebibmacro{conference}%
     \usebibmacro{finentry}}
    {\usebibmacro{incollection}%
     \nopunct}%
}%

%%% 4.5 電子化された資料
%% 4.5.1 電子書籍 → (1-3)単著・共著・編書（noteフィールドで対応）
%% 4.5.2 電子ジャーナル → (5)雑誌論文（eprinttypeやdoi、urlを記入）

%% 4.5.3 Webページ・ブログなど・4.5.4 オンラインデータベースなど
\DeclareBibliographyDriver{online}{%
  \unspace%
  \usebibmacro{author}%
  \usebibmacro{originaldate}% 初出を出力
  \usebibmacro{date+extradate}% 出版年
  % ウェブサイト名・ブログ名は titleaddon に書く。title マクロは titleaddon を書名の中に出すので，退避して書名の後に出す
  \let\jsr@sitename\@empty
  \savefield{titleaddon}{\jsr@sitename}%
  \clearfield{titleaddon}%
  % 表題
  \usebibmacro{title}%
  \newunit%
  % ウェブサイト名（不明な場合は省略）
  \ifdefvoid\jsr@sitename{}{\printtext{\jsr@sitename}}%
  \newunit%
  % ブログの記事作成日：日付に日まであれば出す（ガイド 4.5.3，2026-10-24 決定）
  \iffieldundef{day}{}{\printtext{\mkbibdatelong{year}{month}{day}}}%
  \newunit%
  % 欧文：所在地: 運営機関名
  \ifthenelse{\boolean{CJK}}{}{%
    \iflistundef{location}{}{%
      \printlist{location}%
      \iflistundef{organization}{}{\setunit{\addcolon\space}}}%
    \printlist{organization}}%
  % url
  \newunit%
  \usebibmacro{urldate+eprint/doi/url}%
  \usebibmacro{finentry}%
}%



%% 4.5.4.2 コンピュータファイル（MRDF）
%%  和文：ファイル作成者名，作成年，『ファイル名称』[データ形式]，提供機関名，入手先．
%%  欧文：Author, year, Title[データ形式], 所在地: 提供機関名 [producer]. 入手先（所在地: 名称 [distributor]）.
%%  データ形式＝type，提供機関＝publisher（作成者と同じでも省かない。ガイドの例に合わせる），入手先＝howpublished。
\DeclareBibliographyDriver{dataset}{%
  \usebibmacro{begentry}%
  \usebibmacro{translator/author/editor}%
  \usebibmacro{date+extradate}%
  \ifthenelse{\boolean{CJK}}
    {\usebibmacro{maintitle+title}}
    {\usebibmacro{printtitle}{}}%
  % データ形式は書名にくっつける（書名の後に保留されている副題の区切りは消す）
  \iffieldundef{type}{}{\setunit{}\printfield[brackets]{type}}%
  \ifthenelse{\boolean{CJK}}
    {\setunit*{\printdelim{fhcomma}}%
     \printlist{publisher}%
     \setunit*{\printdelim{fhcomma}}%
     \printfield{howpublished}}
    {\setunit*{\addcomma\space}%
     \printlist{location}%
     \iflistundef{publisher}{}{%
       \setunit*{\addcolon\space}%
       \printlist{publisher}%
       \printtext{\addspace\mkbibbrackets{\bibstring{producer}}}}%
     \setunit*{\adddot\space}%
     \printfield{howpublished}}%
  \usebibmacro{finentry}%
}%

%%% おまけ %%%
%% v) 数巻にわたる書籍
\DeclareBibliographyDriver{mvbook}{%
  \usebibmacro{begentry}%
  %著者名，刊行年
  \usebibmacro{translator/author/editor}%
  \usebibmacro{date+extradate}%
  % 書名（巻数は書名の外に出す）
  \printtext[fhdkakko]{\usebibmacro{printtitle}{}}%
  \usebibmacro{volumes}%
  \setunit{\printdelim{titledelim}}%
  \ifthenelse{\boolean{CJK}}{}%
    {\printlist{location}%
     \setunit*{\addcolon\space}}%
  \usebibmacro{publisher:print}%
  \usebibmacro{finentry}%
}%
\DeclareBibliographyAlias{mvcollection}{mvbook}%

%% (4)編書論文など（共著内の論文を含む）

%% iv) 新聞記事および雑誌記事の引用（howpublished に朝刊・夕刊などを入れた misc は article と同じ書式）
\DeclareBibliographyAlias{misc}{article}%

%% 標準のエントリ型のうち，専用の書式を持たないものの別名（既定のドライバには日付がなく，年が出ないため）
\DeclareBibliographyAlias{booklet}{book}%
\DeclareBibliographyAlias{manual}{book}%
\DeclareBibliographyAlias{reference}{book}%
\DeclareBibliographyAlias{proceedings}{book}%
\DeclareBibliographyAlias{bookinbook}{book}%
\DeclareBibliographyAlias{inreference}{incollection}%
\DeclareBibliographyAlias{suppbook}{incollection}%
\DeclareBibliographyAlias{suppcollection}{incollection}%
\DeclareBibliographyAlias{mvreference}{mvbook}%
\DeclareBibliographyAlias{mvproceedings}{mvbook}%
\DeclareBibliographyAlias{software}{article}%
\DeclareBibliographyAlias{patent}{article}%
\DeclareBibliographyAlias{unpublished}{inproceedings}% 未刊行の口頭報告は学会報告と同じ書式（booktitle がなければ conference）
