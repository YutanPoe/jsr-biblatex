%%% 文献リストでは et al. を使用しない
%\DefineBibliographyStrings{english}{andothers={}}%

%%% 雑誌名の前の「in:」を削除
\renewbibmacro{in:}{}%

%%% vol, volsを削除
\DefineBibliographyStrings{english}{volume={}}%
\DefineBibliographyStrings{english}{volumes={}}%

%%% 翻訳の際に表示される trans. ofを削除
\DefineBibliographyStrings{english}{translationof={}}%


%%%%%%% 文献情報フォーマット・マクロ %%%%%%%

%%% 出版年 %%%
\renewbibmacro*{date+extradate}%
{\iffieldundef{labelyear}{}%
  {\printtext{\iflabeldateisdate{\printlabeldateextra}{\printlabeldateextra}}%
    \setunit*{\printdelim{datetitledelim}}%
  }%
}%

%% 氏名逆転のOnOff %%
\newbibmacro*{reversename}[1]{%
  \ifthenelse{\boolean{reversenamebool}}%
    {\printnames[sortname]{#1}}%
    {\printnames[default]{#1}}}%

%%% 先頭名前　%%%
%% book %%
\newbibmacro*{translator/author/editor}{%翻訳者がいる場合relatedで指定されているため、かならず先頭に出力する必要がある
  \ifnameundef{translator}%
    {\ifboolexpr{%
       test \ifuseauthor
       and
       not test {\ifnameundef{author}}%
     }%
       {\usebibmacro{author}}%
       {\usebibmacro{editor}}}%
    {\usebibmacro{translator}}}%

%%% 先頭名前　%%%
%% inbook article %%
\newbibmacro*{translator/author}{%
  \ifnameundef{translator}%
    {\usebibmacro{author}}%
    {\usebibmacro{translator}}}%

%%% 著者名 %%%
\renewbibmacro*{author}%
{\ifboolexpr{%
  test \ifuseauthor
  and
  not test {\ifnameundef{author}}%
}%
  {\usebibmacro{bbx:dashcheck}%
    {\ifthenelse{\boolean{relatedbool}}%relatedの場合は直前のnamehashと一致していても、ダッシュは出力しない。
      {}{\bibnamedash\printdelim{nameyeardelim}}}%
    {\usebibmacro{bbx:savehash}%
    \usebibmacro{reversename}{author}%
    \iffieldundef{authortype}{}%
      {\setunit{\printdelim{authortypedelim}}%
      \usebibmacro{ed-eds:author}}%
    \setunit*{\printdelim{nameyeardelim}}}}%
  {\global\undef\bbx@lasthash}%%
}%


%% 著者名+出版年 %%
%\newbibmacro*{author+year}{%
%  \printnames{author}%
%  \ifthenelse{\not\ifnameundef{author}}{%
%    \setunit*{\printdelim{nameyeardelim}}%
%  }{%
%    \setunit*{\printdelim{nonameyeardelim}}%
%  }%
%  \iffieldundef{pubstate}{% 印刷中などの情報がない場合は出版年を出力
%    \usebibmacro{date+extradate}%
%  }{%
%    \printfield[parens]{pubstate}%
%  }%
%}%

%%% 編集者名 %%%
\renewbibmacro*{editor}%
{\ifboolexpr{%
  test \ifuseeditor
  and
  not test {\ifnameundef{editor}}%
}%
  {\usebibmacro{bbx:dashcheck}%
    {\ifthenelse{\boolean{relatedbool}}{}%
      {\bibnamedash%
      \usebibmacro{editorstrg}%
      \setunit*{\printdelim{nameyeardelim}}}}%
    {\usebibmacro{reversename}{editor}%%
    \setunit{\printdelim{editortypedelim}}%
    \usebibmacro{bbx:savehash}%
    \usebibmacro{editorstrg}%
    \clearname{editor}%
    \setunit*{\printdelim{nameyeardelim}}}}%
  {\global\undef\bbx@lasthash}}%

%% 編集者名が先頭でない時の出力 %%
\renewbibmacro*{byeditor}{%
  \usebibmacro{bbx:byeditor}{editorstrg}}%
\renewbibmacro*{byeditor+others}{%
  \usebibmacro{bbx:byeditor}{editor+othersstrg}}

\newbibmacro*{bbx:byeditor}[1]{%
  \ifnameundef{editor}{}%
    {\printnames[byeditor]{editor}%
    \setunit{\printdelim{editortypedelim}}%
    %\usebibmacro{ed-eds:editor}%
    \usebibmacro{#1}%
    \setunit{\printdelim{titledelim}}}%
  \usebibmacro{bbx:byeditorx}{#1}}%

\newbibmacro*{bbx:byeditorx}[1]{%
  \ifnameundef{editora}{}%
    {\printnames[byeditor]{editora}%
    \setunit{\printdelim{editortypedelim}}%
    %\usebibmacro{ed-eds:editor}%
    \usebibmacro{#1}%
    \setunit{\printdelim{titledelim}}}%
  \ifnameundef{editorb}{}%
    {\printnames[byeditor]{editorb}%
    \setunit{\printdelim{editortypedelim}}%
    %\usebibmacro{ed-eds:editor}%
    \usebibmacro{#1}%
    \setunit{\printdelim{titledelim}}}%
  \ifnameundef{editorc}{}%
    {\printnames[byeditor]{editorc}%
    \setunit{\printdelim{editortypedelim}}%
    %\usebibmacro{ed-eds:editor}%
    \usebibmacro{#1}%
    \setunit{\printdelim{titledelim}}}}%

