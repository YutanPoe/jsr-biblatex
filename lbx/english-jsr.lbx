\ProvidesFile{english-jsr.lbx}[\abx@lbxid]

%% english.lbx を継承
\InheritBibliographyExtras{english}
\InheritBibliographyStrings{english}


\NewBibliographyString{reprintin}
\NewBibliographyString{paperpresented}


\DeclareBibliographyStrings{%
  reprintin = {{Reprinted in}{Reprinted in}},%
  volume    = {{}{}},%
  volumes   = {{}{}},%
  translationof = {{}{}},%
  techreport = {{Technical Report}{Technical Report}},% 報告書の種類（略さない）
  paperpresented = {{Paper presented at the}{Paper presented at the}},% 欧文の学会報告（ASA）
  phdthesis = {{PhD dissertation}{PhD dissertation}},% 博士論文（ASA）
  mathesis = {{MA thesis}{MA thesis}},%
}


