%% japanese-jsr.lbx --- localisation strings of the jsr style (part of jsr-biblatex).
%% Copyright (C) 2022-2026 Takuya MASUDA.  LaTeX Project Public License 1.3c or later; see jsr.bbx.
\ProvidesFile{japanese-jsr.lbx}[\abx@lbxid]

%% japanese.lbx を継承
\InheritBibliographyExtras{japanese}
\InheritBibliographyStrings{japanese}

\NewBibliographyString{reprintin}
\NewBibliographyString{paperpresented}
\NewBibliographyString{producer}
\NewBibliographyString{totalprefix}
\NewBibliographyString{totalvolumes}
\NewBibliographyString{newspaperpage}
\NewBibliographyString{origpublished}
\NewBibliographyString{prenumber}

\DeclareBibliographyStrings{%
  %% 文献リスト見出し（bbxの\defbibheadingと対応）
  bibliography     = {{文献}{文献}},
  references       = {{文献}{文献}},
  %% 役割語
  %% bbxの authortypedelim（スペースなし）と組み合わさり「稲上毅編」の形になる
  editor           = {{編}{編}},
  editors          = {{編}{編}},
  translator       = {{訳}{訳}},
  translators      = {{訳}{訳}},
  %% 著者省略（cbxのandothersdelimから\bibstring{andothers}で参照）
  andothers        = {{ほか}{ほか}},
  %% 出版年不明・近刊（pubstateフィールド経由で自動出力）
  nodate           = {{n.d.}{n.d.}},
  forthcoming      = {{近刊}{近刊}},
  %% 再録（bbxのreprintof:japaneseマクロから\bibstring{reprintfrom}で参照）
  %% コロンはfhcolonデリムで別途追加するためここには含めない
  reprintin        = {{再録}{再録}},
  %% URL取得日（bbxのurldateフィールドフォーマットから\bibstring{urlseen}で参照）
  urlseen          = {{取得}{取得}},
  prenumber        = {{第}{第}},
  %% 学位論文の種類（略さない：修論→修士論文）
  mathesis         = {{修士論文}{修士論文}},
  phdthesis        = {{博士論文}{博士論文}},
  %% 欧文の学会報告（和文では使わない）
  paperpresented   = {{Paper presented at the}{Paper presented at the}},
  producer = {{producer}{producer}},% MRDF の作成者（ASA の [producer]）
  %% 全10巻，第3面，（2005，日本放送出版協会刊）の「全」「巻」「面」「刊」（bbx の volumes、pages、ebook:orig）
  totalprefix = {{全}{全}},%
  totalvolumes = {{巻}{巻}},%
  newspaperpage = {{面}{面}},%
  origpublished = {{刊}{刊}},%
}
\endinput%