\ProvidesFile{french-jsr.lbx}[\abx@lbxid]

%% french.lbx を継承
\InheritBibliographyExtras{french}
\InheritBibliographyStrings{french}

\NewBibliographyString{reprintin}
\NewBibliographyString{paperpresented}
\NewBibliographyString{producer}
\NewBibliographyString{totalprefix}
\NewBibliographyString{totalvolumes}
\NewBibliographyString{newspaperpage}
\NewBibliographyString{origpublished}
\NewBibliographyString{specialissue}

\DeclareBibliographyStrings{%
  reprintin = {{Reprinted in}{Reprinted in}},%
  volume    = {{}{}},%
  volumes   = {{}{}},%
  translationof = {{}{}},%
  paperpresented = {{Paper presented at the}{Paper presented at the}},% 欧文の学会報告（ASA）
  producer = {{producer}{producer}},% MRDF の作成者（ASA の [producer]）
  %% 10 vols.（bbx の volumes）。全・面・刊は和文だけで使う
  totalprefix = {{}{}},%
  totalvolumes = {{vols\adddot}{vols\adddot}},%
  newspaperpage = {{}{}},%
  origpublished = {{}{}},%
  specialissue = {{Special issue}{Special issue}},% @periodical の特集名の標識（特集 X／Special issue）
  urlseen = {{Retrieved}{Retrieved}},% (Retrieved January 10, 2009, URL)
}

\DeclareBibliographyExtras{%Family Nameのスモールキャピタル(Petites capitales)を解除するが、本当にこれでよいのだろうか…
  \restorecommand\mkbibnamefamily
}