\ProvidesFile{jsr.dbx}[2026/10/24\space v1.0\space JSR biblatex style data model]
\DeclareDatamodelFields[type=list, datatype=name, label=true]{origauthor}
\DeclareDatamodelEntryfields{origauthor}
\DeclareDatamodelFields[type=list, datatype=name, label=true]{translatora}
\DeclareDatamodelEntryfields{translatora}
\DeclareDatamodelFields[type=field,datatype=literal]{translatortype}
\DeclareDatamodelEntryfields{translatortype}
\DeclareDatamodelFields[type=field,datatype=literal]{translatoratype}
\DeclareDatamodelEntryfields{translatoratype}
% 同一著者の並び順（単著→単独編書→共著→共編書）のためのソート用フィールド。bbx の sourcemap が設定する
\DeclareDatamodelFields[type=field,datatype=integer]{jsrsortrole}
\DeclareDatamodelEntryfields{jsrsortrole}
% sortname の書き忘れの検出用。bbx の sourcemap が，sortname のないエントリに 1 を設定する
\DeclareDatamodelFields[type=field,datatype=integer]{jsrnosortname}
\DeclareDatamodelEntryfields{jsrnosortname}
% 旧形式の bib（webpagetitle、@report＋type=onlinereport）の検出用。bbx の sourcemap が，読み替える前に印を付ける
\DeclareDatamodelFields[type=field,datatype=literal]{jsrlegacy}
\DeclareDatamodelEntryfields{jsrlegacy}
% author のない article 型（article、misc、software、patent）の検出用。bbx の sourcemap が印を付ける（新聞・雑誌は news，それ以外は 1）
\DeclareDatamodelFields[type=field,datatype=literal]{jsrnoauthor}
\DeclareDatamodelEntryfields{jsrnoauthor}
