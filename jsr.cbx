\ProvidesFile{jsr.cbx}[2026/10/24\space v1.0\space JSR biblatex citation style]

\RequireCitationStyle{authoryear-comp}

%% オプションの設定
\ExecuteBibliographyOptions{%
maxcitenames=2,% 3人以上は「〜ら」とする
mincitenames=1,% あたりまえ体操
uniquelist=minyear,% 発行年が違えば著者名を追跡して曖昧さを判断しない
uniquename=full,% 同年の同じ名字の著作があった場合、英語はイニシャルを、日本語は名前を表示させる
sortcites=true,% 引用をymdでソートする
giveninits=false,% givenをイニシャルにしない
autolang=other,%
language=auto,%
}

% 引用ごとに言語を判断して処理
\AtEveryCitekey{%
  \usebibmacro{checkLang}%言語の判定
  \jsr@scankata% カタカナ名の判定（bbx）
  \global\boolfalse{cbx:warichu}%割注かどうかの判断%
  \csundef{cbx:relatedloop}%related循環参照防止リストを引用キーごとにリセット
}%

% ================================================================================
% related循環参照防止（standard.bbx の \ifrelatedloop 相当を引用処理用に用意）
% ================================================================================
%
% 【設計方針】
%  ・cite:uniquename / check:samename / save:namehash / cite:author は，
%    related を「途切れるまで」辿って最果ての著者名・namehashを求める。
%  ・cite:reprintof / cite:translationof は，related を辿りながら
%    relatedtype に応じた書式（角カッコの原著年，"=" 連結の翻訳年）で
%    出版年を積み上げていく。
%  ・いずれも「related 先へ降下する」という操作を繰り返すため，
%    自己参照・相互参照があると無限ループになる。bbx 側と同様に，
%    訪問済み entrykey を cbx:relatedloop リストに記録し，再訪を検出したら
%    そこで探索を打ち切る（＝そのエントリの情報をそのまま採用する）。

% 現在のエントリ（entrykey / clonesourcekey）が既に訪問済みか判定
\def\ifcbxrelatedloop{%
  \ifboolexpr{ test {\xifinlistcs{\strfield{entrykey}}{cbx:relatedloop}}
    or test {\xifinlistcs{\strfield{clonesourcekey}}{cbx:relatedloop}} }}

% related 先へ安全に降下する共通マクロ
%  #1 : 降下後（related 先のエントリコンテキスト）で実行するコード
%  related が未定義，または循環を検出した場合は何もしない
%  （＝呼び出し元は「その場で処理を打ち切る」分岐を別途用意すること）
\newbibmacro*{cbx:descend}[1]{%
  \ifboolexpr{ test {\iffieldundef{related}} or test {\ifcbxrelatedloop} }%
    {}%
    {\listcsxadd{cbx:relatedloop}{\strfield{entrykey}}%
     \iffieldundef{clonesourcekey}
       {}
       {\listcsxadd{cbx:relatedloop}{\strfield{clonesourcekey}}}%
     \entrydata*{\thefield{related}}{%
       \usebibmacro{checkLang}%
       #1}}}%



% ================================================================================
% 表現の調整パート
% ================================================================================


% デリムの調整
% ================================================================================

% グローバル
\DeclareDelimFormat[textcite,parencite]{nameyeardelim}{\addspace}%著者名と出版年の区切りは半角スペース
\DeclareDelimFormat{transeq}{\unspace=}%翻訳書の場合のイコール

% parenciteのときとtextciteのときを共通に
\DeclareDelimFormat[parencite,textcite,citeauthor]{multinamedelim}% 人の著者名の間
  {\ifthenelse{\boolean{CJK}}{\jsr@cjknamedelim}{\addcomma\space}}%
\DeclareDelimFormat[parencite,textcite,citeauthor]{finalnamedelim}%
  {\ifthenelse{\boolean{CJK}}{\jsr@cjknamedelim}{\addhnspace\bibstring{and}\addhnspace}}%
\DeclareDelimFormat[parencite]{andothersdelim}% 3人以上のときの最後の文字
  {\addhnspace\bibstring{andothers}}%

% textciteのとき（スタイルガイドに明確な定義はなし）
%\DeclareDelimFormat[textcite,citeauthor]{multinamedelim}{\unspace{と}}% 和英どちらも「と」にしてみた
%\DeclareDelimFormat[textcite,citeauthor]{finalnamedelim}{\unspace{と}}% 和英どちらも「と」にしてみた
  %{\ifthenelse{\boolean{japanese}}{\unspace{・}}%
    %{\ifnumgreater{\value{liststop}}{2}{\finalandcomma}{}\addthinspace\&\thinspace}}%
% 3人以上のとき：本文中の引用も割注と同じく「ほか」「et al.」（ガイド 3.2。以前は和欧とも「ら」）
\DeclareDelimFormat[textcite,citeauthor]{andothersdelim}{\addhnspace\bibstring{andothers}}%

% FiledFormatの宣言
% ================================================================================

%書籍タイトル関係
\DeclareFieldFormat{citetitle}{『#1』}% 基本は和英関わらず二重鉤かっこ
\DeclareFieldFormat% 論文名などは言語ごとに判断
  [article,inbook,incollection,inproceedings,patent,thesis,unpublished]
  {citetitle}{\mkbibquote{#1}}%
\DeclareFieldFormat
  [suppbook,suppcollection,suppperiodical]
  {citetitle}{#1}% なんかあった、たぶん使わない

% ページ数関係
\DeclareFieldFormat{postnote}% ページ範囲の圧縮「123-125」を「123-5」に（ハイフンは \mkjsrrange）
  {\mkjsrrange{#1}}%
\DeclareDelimFormat{postnotedelim}
  {\addcolon\space}%  発行年とページ数の区切りは半角コロンと半角スペース
\DeclareDelimFormat{multipostnotedelim}
  {\nopunct}% 複数ページ数が表示された際に、余計なコンマなどを入れない


% 新しいコマンドの定義
% ================================================================================

%全角丸かっこ関連
\newcommand{\fparenopen}{\unspace（}%全角丸かっこ開き
\newcommand{\fparenclose}{\unspace）}%全角丸かっこ閉じ
% \mkbibfparens（全角丸かっこ）は bbx で定義している

% 複数citesコマンドを並べたときの区切り文字（文書全体で変更）
\renewcommand*{\textcitedelim}{%
%  \iftoggle{bbx:engmode}{%
%    \iffinalcitedelim{%
%      \ifnumgreater{\value{textcitetotal}}{2}
%        {\iftextcitepunct{\finalandsemicolon}{\finalandcomma}}{}%
%      \addspace\bibstring{and}}%
%      {\iftextcitepunct{\addsemicolon}{\addcomma}}%
%    \space%
%  }{%
    \iffinalcitedelim{%
      \ifnumequal{\value{textcitetotal}}{2}{%
        \printtext{と}%
      }{%
        \printtext{，}%
        \iffinalcitedelim{\printtext{および}}{}%
      }%
    }{\printtext{，}}%
%  }%
}

%%==========新しい変数の定義==========
\newbool{cbx:samename}%
\newbool{cbx:warichu}%
\newbool{cbx:giveninits}%
\global\booltrue{cbx:giveninits}%

%%==========お名前調整==========

%% 曖昧さ回避の場合の「他」の前のコンマを削除
\renewbibmacro*{name:andothers}{%
  \ifthenelse{\equal{\value{listcount}}{\value{liststop}}\AND\ifmorenames}{%
    \ifthenelse{\boolean{CJK}}{}{%  
      \ifnumgreater{\value{liststop}}{1}%
        {\finalandcomma}%
        {}}%
      \printdelim{andothersdelim}}
{}}%

%labelnameをuniquenameをつかって出力するときの名前フォーマット
\newbibmacro{apply:uniquename}[3]{%
  \ifthenelse{\value{listcount}>1\OR\ifuniqueprimaryauthor}%
    {\setcounter{uniquename}{0}}%
    {}%
  \ifthenelse{\boolean{CJK}}{% CJKの場合
    % カタカナ名のフルネームは「名・姓」（ロス・マオア）
    \ifcase\value{uniquename}%
      {\ifboolexpr{ test {\ifstrequal{#1}{family-given}} and test {\jsr@ifkatakana\namepartfamily} }
        {\usebibmacro{jsr:kataname}}%
        {\usebibmacro{name:#1}%通常（佐藤）、フルネーム出力の場合はフルネーム
          {\namepartfamily}{\namepartgiven}{\relax}{\relax}}}%
    \or%
      {\jsr@ifkatakana\namepartfamily{\usebibmacro{jsr:kataname}}%
        {\usebibmacro{name:family-given}%名前まで（佐藤健二）
          {\namepartfamily}{\namepartgiven}{\relax}{\relax}}}%
    \or%
      {\jsr@ifkatakana\namepartfamily{\usebibmacro{jsr:kataname}}%
        {\usebibmacro{name:family-given}%上に同じ
          {\namepartfamily}{\namepartgiven}{\relax}{\relax}}}%
    \fi%
  }{%
    \ifgiveninits{\def\cbx@tempa{\namepartgiveni}}{\def\cbx@tempa{\namepartgiven}}%
    \ifcase\value{uniquename}% CJK以外の場合
      \ifuseprefix% familyで特定できる場合、フルネームのときはgiveni
        {\usebibmacro{name:#2}%
          {\namepartfamily}{\cbx@tempa}{\namepartprefix}{\relax}}%
        {\usebibmacro{name:#2}%
          {\namepartfamily}{\cbx@tempa}{\relax}{\relax}}%
    \or%
      \ifuseprefix% giveniで特定できる場合（常に頭文字）
        {\usebibmacro{name:#3}%
          {\namepartfamily}{\namepartgiveni}{\namepartprefix}{\relax}}%
        {\usebibmacro{name:#3}%
          {\namepartfamily}{\namepartgiveni}{\relax}{\relax}}%
    \or%
      \ifuseprefix% givenをつかってフルネーム表記
        {\usebibmacro{name:#3}%
          {\namepartfamily}{\namepartgiven}{\namepartprefix}{\relax}}%
        {\usebibmacro{name:#3}%
          {\namepartfamily}{\namepartgiven}{\relax}{\relax}}%
    \fi%
  }%
  \usebibmacro{name:andothers}%
}%

\DeclareNameFormat{labelname}%一般的なlabelname
  {\usebibmacro{apply:uniquename}%
    {family}%日本語uniqunameLv1
    {family}%外国語uniqunameLv1
    {given-family}}%外国語uniqunameLv2〜
\DeclareNameFormat{labelname:parencite}%parenciteのときの、必ずfamilyが先の場合
  {\usebibmacro{apply:uniquename}%
    {family}%日本語uniqunameLv1
    {family}%外国語uniqunameLv1
    {family-given}}%外国語uniqunameLv2〜
\DeclareNameFormat{labelname:fullname}%最初に引用したときのフルネーム用
  {\usebibmacro{apply:uniquename}%
    {family-given}%
    {given-family}%
    {given-family}}%

\DeclareNameAlias{translator}{labelname}
\DeclareNameAlias{origauthor}{labelname}


%%%====================
%
% 実際の処理パート
%
%%%====================

%%% 引用形式定義 %%%
%% 最初の引用時はフルネーム %%
%% 初出の人物はフルネーム、既出の人物は姓のみ（引用キーではなく人物単位で判定）
%%  ・オプション firstfull=true（既定）：名前ハッシュ（人物）ごとに初出を判定する。
%%    同じ著者の別文献や、共著者の一人の単著を引用した場合も既出とみなす。
%%    割注（\parencite）は言及に数えない。
%%  ・オプション firstfull=false：従来どおり、引用キーごとに判定する（\ifciteseen）。
\newbool{cbx:firstfull}%
\DeclareBiblatexOption{global}[boolean]{firstfull}[true]{%
  \ifstrequal{#1}{true}{\global\booltrue{cbx:firstfull}}{\global\boolfalse{cbx:firstfull}}}%
\ExecuteBibliographyOptions{firstfull=true}%
\newcommand*{\cbx@seennames}{}% 既出の人物の名前ハッシュのリスト（グローバル）
\def\cbx@markseen#1{%
  \edef\cbx@tmph{#1}%
  \expandafter\listgadd\expandafter\cbx@seennames\expandafter{\cbx@tmph}}%
%  共著（名前リストが2名以上）は全体を1つの著者単位として判定する：
%   ・名前リスト全体（namehash）が既出でなければフルネーム（構成員の一人が既出でも）
%   ・初出のとき、構成員それぞれも既出として登録する（後の単著は姓のみ）
%  単著は人物（name hash）ごとに判定する。
\DeclareNameFormat{labelname:person}{%
  \ifnumgreater{\value{liststop}}{1}%
    {\xifinlist{\thefield{namehash}}{\cbx@seennames}%
       {\usebibmacro{apply:uniquename}{family}{family}{given-family}}%
       {\usebibmacro{apply:uniquename}{family-given}{given-family}{given-family}%
        \cbx@markseen{\thefield{hash}}%
        \ifnumequal{\value{listcount}}{\value{liststop}}%
          {\cbx@markseen{\thefield{namehash}}}{}}}%
    {\xifinlist{\thefield{hash}}{\cbx@seennames}%
       {\usebibmacro{apply:uniquename}{family}{family}{given-family}}%
       {\usebibmacro{apply:uniquename}{family-given}{given-family}{given-family}%
        \cbx@markseen{\thefield{hash}}}}}%
\newbibmacro*{citecheck}{%
  \ifbool{cbx:firstfull}%
    {\printnames[labelname:person]{labelname}}%
    {\ifciteseen{%
       \printnames{labelname}%
     }{%
       \printnames[labelname:fullname]{labelname}%
     }}%
}%

%%% 曖昧さを考慮したlabelnameとed-edsを、
%%% relatedが途切れるまで（または循環を検出するまで）追跡して出力する
\newbibmacro*{cite:uniquename}{%
  \ifboolexpr{ test {\iffieldundef{related}} or test {\ifcbxrelatedloop} }{%
    %基底ケース：relatedなし，または循環検出のためここで打ち切る
    \unspace%
    \ifbool{cbx:warichu}%
      {\printnames[labelname:parencite]{labelname}}%
      {\usebibmacro{citecheck}}%
    \ifboolexpr{%
      test {\ifnameundef{author}}%
      and%
      not test {\ifnameundef{editor}}%
    }%
      {\setunit{\printdelim{editortypedelim}}%
      \midsentence\usebibmacro{editorstrg}}%
    {}%
  }{%
    \usebibmacro{cbx:descend}{\usebibmacro{cite:uniquename}}%
  }%
  \csundef{cbx:relatedloop}%
}%

%% namehashが同じかどうかをrelatedが途切れるまで（または循環を検出するまで）遡って判断する
\newbibmacro*{check:samename}{%
  \ifboolexpr{ test {\iffieldundef{related}} or test {\ifcbxrelatedloop} }{%
    \csundef{cbx:relatedloop}%
    \iffieldequals{namehash}{\cbx@lasthash}{%
      \global\booltrue{cbx:samename}%
    }{%
      \global\boolfalse{cbx:samename}%
    }%
  }{%
    \usebibmacro{cbx:descend}{\usebibmacro*{check:samename}}%
  }%
  \csundef{cbx:relatedloop}%
}%

%% namehashをrelatedが途切れるまで（または循環を検出するまで）遡って保存する
\newbibmacro{save:namehash}{%
  \ifboolexpr{ test {\iffieldundef{related}} or test {\ifcbxrelatedloop} }{% namehashの保存
    \savefield{namehash}{\cbx@lasthash}% relatedが設定されていない，または循環検出の場合は素直にnamehashを保存
    \csundef{cbx:relatedloop}%
  }{% relatedが設定されている場合は設定先のnamehashを遡って保存
    \usebibmacro{cbx:descend}{\usebibmacro{save:namehash}}%
  }%
  \csundef{cbx:relatedloop}%
}%

%%% author et al.(year: pages) %%%
%% 本体 %%
\renewbibmacro*{textcite}{%
  \global\boolfalse{cbx:warichu}%
  \usebibmacro{cbx:checkdualpages}%
  \usebibmacro*{check:samename}%
  \ifbool{cbx:samename}{% 同じ著者の引用が複数続く場合は区切り文字と出版年のみを表示
    \setunit{\compcitedelim}%
    \usebibmacro{cite:plabelyear+extradate}%
  }{%引用開始
    \ifbool{cbx:parens}{% parenが開いていれば
      \fparenclose% 全角閉じ丸かっこを挿入し
      \global\boolfalse{cbx:parens}% cbx:parensをfalseにする
    }{}%
    \setunit{\textcitedelim}% 複数引用時のデリムの追加
    \ifnameundef{origauthor}{% 著者名 日本語訳の書籍の場合は，原著者の名前を原語表記
      \usebibmacro{cite:uniquename}%
    }{%
      \printnames{origauthor}% 再録の場合のオリジナル出力
    }%
    \setunit{%
      \global\booltrue{cbx:parens}% cbx:parensでparenをopenの状態に
      \printdelim{nameyeardelim}% 著者名と出版年の区切り
      \fparenopen% 全角開き丸かっこを挿入
    }%「prenote」の処理
    \ifnumequal{\value{citecount}}{1}{%
      \usebibmacro{prenote}%
      }{}%
    % 出版年
    \usebibmacro{cite:plabelyear+extradate}%
    % 著者名ハッシュの一時保存
    \usebibmacro{save:namehash}%
    \stepcounter{textcitecount}%
  }%
}%

%% 原書と訳書の両方のページ（ガイド 3.2）：\parencite[78=86]{訳書} →（Goffman 1961: 78=1984: 86）
%%  訳書（relatedtype=translationof）の postnote に「=」があれば，前を原書，後ろを訳書のページとする
\newbool{cbx:dualpages}
\def\cbx@splitpn#1=#2=#3\@nil{\gdef\cbx@pn@orig{#1}\gdef\cbx@pn@trans{#2}\gdef\cbx@pn@rest{#3}}
\newbibmacro*{cbx:checkdualpages}{%
  \global\boolfalse{cbx:dualpages}%
  \ifboolexpr{ test {\iffieldequalstr{relatedtype}{translationof}}
                and not test {\iffieldundef{postnote}} }
    {\expandafter\cbx@splitpn\abx@field@postnote==\@nil
     \ifdefempty\cbx@pn@rest{}{\global\booltrue{cbx:dualpages}}}
    {}}
\renewbibmacro*{postnote}{%
  \iffieldundef{postnote}{}{%
    \setunit{\printdelim{postnotedelim}}%
    \ifbool{cbx:dualpages}
      {\printtext[postnote]{\cbx@pn@trans}}
      {\printfield{postnote}}}}

%% textciteの終わりを全角かっこに変更
\renewbibmacro*{textcite:postnote}%
{\usebibmacro{postnote}%
\ifthenelse{\value{multicitecount}=\value{multicitetotal}}%
  {\setunit{}%
   \printtext{%
     \ifbool{cbx:parens}%
       {\fparenclose%
       \global\boolfalse{cbx:parens}}%
       {}}}%
  {\setunit{%
     \ifbool{cbx:parens}%
       {\fparenclose%
       \global\boolfalse{cbx:parens}}%
       {}%
     \textcitedelim}}}%


%%% (author et al.year: pages) %%%
\renewbibmacro*{cite}{%
  \global\booltrue{cbx:warichu}%
  \usebibmacro{cbx:checkdualpages}%
  \usebibmacro*{check:samename}%
  \ifbool{cbx:samename}{% 同じ著者の引用が複数続く場合は区切り文字と出版年のみを表示
    \setunit{\compcitedelim}%
    \usebibmacro{cite:plabelyear+extradate}%
  }{%引用開始
  \ifboolexpr{
    test {\iffieldundef{related}}
    and
    test {\ifnameundef{labelname}}
    }{%著者も編者もrelatedでリンクもされていない場合
      \iflistundef{institution}%
        {\usebibmacro{noauthorcite}}%
        {\usebibmacro{institutioncite}}%
    }{%
      \ifnameundef{origauthor}{%再販著者情報がない場合
        \usebibmacro{cite:uniquename}%名前の出力
      }{%
        \printnames{origauthor}%再販著者情報がある場合、それを出力
      }%
      \setunit{\printdelim{nameyeardelim}}% authorとyearの間のデリム
      \usebibmacro{cite:plabelyear+extradate}% yearの出力
      \usebibmacro{save:namehash}%
    }%
  \setunit{\multicitedelim}% 複数引用時のデリムの追加
  }%
}%

%% 著者のいない報告書：機関名を著者の位置に出力する
\newbibmacro*{institutioncite}{%
  \printlist{institution}%
  \setunit{\printdelim{nameyeardelim}}%
  \usebibmacro{cite:plabelyear+extradate}}

%% 新聞や雑誌といった誌名を割注内に表示する場合の処理（authorフィールドを省略する）
%%  和文：（『朝日新聞』1998.11.3 朝刊，第○版，○面）  欧文：（The New York Times, November 3, 1998）
\newbibmacro*{noauthorcite}{%
  \ifentrytype{periodical}{\usebibmacro{periodicalcite}}{\usebibmacro{noauthorcite:article}}}

%% 編者のない @periodical：（『誌名』1988）
\newbibmacro*{periodicalcite}{%
  \printtext[journaltitle]{\usebibmacro{printtitle}{}}%
  \setunit{\printdelim{nameyeardelim}}%
  \usebibmacro{cite:plabelyear+extradate}}

\newbibmacro*{noauthorcite:article}{%
  \usebibmacro{journal}%
  \jsr@ifnewsmag{%
    \ifthenelse{\boolean{CJK}}{\usebibmacro{yyyymmdd}}{\printdate}}{}%
  \jsr@ifnewspaper
    {\usebibmacro{newspaper:edition}}%
    {\usebibmacro{magazine:volpages}}}

%% 雑誌：巻(号): ページ（bbx の vol+pages は末尾に \newunit があり，割注では閉じ括弧の前に空白が入る）
\newbibmacro*{magazine:volpages}{%
  \iffieldundef{howpublished}{%
    \usebibmacro{volume+issues}%
    \iffieldundef{pages}{}{\setunit{\addcolon\space}\printfield{pages}}%
  }{%
    \printtext{\ifthenelse{\boolean{CJK}}{\addspace}{\adddot}\printfield{howpublished}}%
  }}

%% 朝刊・夕刊，版，ページ（和文の新聞のみ）
\newbibmacro*{newspaper:edition}{%
  \ifthenelse{\boolean{CJK}}{%
    \iffieldundef{issue}{}{\setunit*{\addspace}\printfield{issue}}%
    \iffieldundef{note}{}{\setunit*{\printdelim{fhcomma}}\printfield{note}}%
    \iffieldundef{pages}{}{\setunit*{\printdelim{fhcomma}}\printtext{\printfield{pages}\bibstring{newspaperpage}}}%
  }{}}

% relatedtypeがreprintofの場合の処理
\newbibmacro*{cite:reprintof}%
{\iffieldequalstr{relatedtype}{reprintof}%
  {\usebibmacro{cbx:descend}{%
    \usebibmacro{cite:translationof}%
    \printtext[brackets]{\jsr@printdateextra}\space}}%
  {}%
}%
% relatedtypeがtranslationofの場合の処理
\newbibmacro*{cite:translationof}%
{\iffieldequalstr{relatedtype}{translationof}%
  {\usebibmacro{cbx:descend}{%
    \usebibmacro{cite:reprintof}%
    \usebibmacro{cite:origyear}%
    \printtext{\jsr@printdateextra}%
    \ifbool{cbx:dualpages}% 原書のページ
      {\setunit{\printdelim{postnotedelim}}\printtext[postnote]{\cbx@pn@orig}}
      {}%
    \setunit{\printdelim{transeq}}%
    }}%
  {}%
}%
% 再販情報のみ（origyear記載）があった場合の処理
% 電子書籍（origpublisher あり）は原典の年を出さない。原典のエントリがない訳書（translator あり）は
% （ベック 1986=1998）の形、それ以外の再刊は（吉田 [1974] 1990）の形。
\newbibmacro*{cite:origyear}%
{\ifboolexpr{ test {\iffieldundef{origyear}} or not test {\iffieldundef{related}}
               or not test {\iflistundef{origpublisher}} }{}%
  {\usebibmacro{cite:translationof}%
   \ifnameundef{translator}
     {\printtext[brackets]{\thefield{origyear}}%
      \setunit{\addthinspace}}
     {\printtext{\thefield{origyear}}%
      \setunit{\printdelim{transeq}}}%
  }%
}%

% 翻訳や再版の場合の処理を含む出版年の処理 %apa 
\newbibmacro*{cite:plabelyear+extradate}%
  {\iffieldundef{year}%dateで設定されたyearがあるの場合の分岐
  %なければ印刷状態を出力
    {\iffieldundef{pubstate}%
      {\jsr@printdateextra}%
      {\printfield{pubstate}}}%
    {\usebibmacro{cite:origyear}%再販情報のみ（origyear記載）があった場合
    %翻訳書・再録の場合
    \usebibmacro{cite:reprintof}%
    \usebibmacro{cite:translationof}%
    \jsr@printdateextra%
  }}%

% citeauthorの場合の処理 apa.cbxのものを修正
\newbibmacro*{cite:author}{%
  \ifboolexpr{ test {\iffieldundef{related}} or test {\ifcbxrelatedloop} }{%
    \iffieldequals{namehash}{\cbx@lasthash}{%
      % Multiple cites in one command
      \setunit{\compcitedelim}%
      \usebibmacro{cite:plabelyear+extradate}%
    }{%
      % Single cite
      \ifnameundef{labelname}{%
        % No author/editor
        \usebibmacro{cite:noname}%
        \savefield{namehash}{\cbx@lasthash}%
      }{%
        % Normal cite
        \ifnameundef{origauthor}{% 著者名 日本語訳の書籍の場合は，原著者の名前を原語表記
          \usebibmacro{citecheck}%
        }{%
          \printnames{origauthor}% 再録の場合のオリジナル出力
        }%
        \savefield{namehash}{\cbx@lasthash}%
      }%
    }%
    \setunit{\multicitedelim}%
  }{%
    \usebibmacro{cbx:descend}{\usebibmacro{cite:author}}%
  }%
}%
%%parenciteのかっこを全角に設定
%%% \DeclareCiteCommand{〈command〉}[〈wrapper〉]{〈precode〉}{〈loopcode〉}{〈sepcode〉}{〈postcode〉}
\DeclareCiteCommand{\parencite}[\mkbibfparens]{%
  \usebibmacro{cite:init}%
  \usebibmacro{prenote}%
}{% loopcode
  \usebibmacro{citeindex}%
  \usebibmacro{cite}%
}{%
% sepcode
}{%
  \usebibmacro{postnote}%
}%

%% 引用時のコマンドの宣言等
\DeclareCiteCommand{\citeauthor}
  {\usebibmacro{cite:init}%
   \usebibmacro{prenote}}
  {\usebibmacro{citeindex}%
   \usebibmacro{cite:author}}%
  {}
  {\usebibmacro{postnote}}

\DeclareCiteCommand*{\parencite}[\mkbibfparens]%
  {%\fparenopen%
  \usebibmacro{cite:init}%
  \usebibmacro{prenote}}%
  {\usebibmacro{citeindex}%
  \usebibmacro{cite}}%
  {}%
  {\usebibmacro{postnote}}%
  %\fparenclose}%

\DeclareMultiCiteCommand{\parencites}[\mkbibfparens]{\parencite}
  {\setunit{\multicitedelim}}
\endinput
